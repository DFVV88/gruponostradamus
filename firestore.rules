rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'fernandodaniel8888@gmail.com';
    }

    function isOfficialRoom(roomId) {
      return roomId in [
        'alumnos-general',
        'alumnos-matematica',
        'alumnos-fisica',
        'alumnos-quimica',
        'alumnos-aptitud-academica',
        'alumnos-humanidades',
        'externos-general',
        'externos-informes',
        'externos-orientacion-uni'
      ];
    }

    function isAlumnoRoom(roomId) {
      return roomId in [
        'alumnos-general',
        'alumnos-matematica',
        'alumnos-fisica',
        'alumnos-quimica',
        'alumnos-aptitud-academica',
        'alumnos-humanidades'
      ];
    }

    function isExternoRoom(roomId) {
      return roomId in [
        'externos-general',
        'externos-informes',
        'externos-orientacion-uni'
      ];
    }

    function hasUserProfile() {
      return request.auth != null
        && exists(
          /databases/$(database)/documents/users/$(request.auth.uid)
        );
    }

    function isActiveUser() {
      return hasUserProfile()
        && get(
          /databases/$(database)/documents/users/$(request.auth.uid)
        ).data.status == 'active'
        && get(
          /databases/$(database)/documents/users/$(request.auth.uid)
        ).data.blocked == false;
    }

    function canReadRoom(roomId) {
      return isOfficialRoom(roomId)
        && (
          isExternoRoom(roomId)
          || isAdmin()
          || isActiveUser()
        );
    }

    function canCreateInRoom(roomId) {
      return isOfficialRoom(roomId)
        && (
          isExternoRoom(roomId)
          || isAdmin()
          || isActiveUser()
        );
    }

    /*
     * FUNCIONES DE VALIDACIÓN PARA PREINSCRIPCIONES
     *
     * Se dividen en funciones pequeñas para evitar el error:
     * "Expression is too complex to evaluate safely".
     */
    function hasAllowedPreinscripcionFields(d) {
      return d.keys().hasOnly([
        'nombre',
        'dni',
        'celular',
        'correo',
        'colegio',
        'situacion',

        'programaId',
        'ciclo',
        'planId',
        'planNombre',
        'modalidad',
        'turno',

        'precioReferencia',
        'matriculaReferencia',
        'tipoCobroReferencia',
        'cobroInicial',
        'conceptoPagoInicial',
        'totalInicial',
        'montoPagoInicial',
        'montoPagoInicialCentimos',
        'moneda',
        'detallePagosPosteriores',

        'apoderado',
        'celularApoderado',
        'comentario',
        'confirmacion',

        'metodoPagoPreferido',
        'metodoPagoLabel',
        'estadoPago',
        'pagoValidado',
        'pagoObservacion',
        'precioValidadoServidor',
        'estadoPrecio',
        'intentoPagoCreado',
        'asesorAsignado',

        'estado',
        'origen',
        'tipo',
        'lineaAcademica',
        'correoInstitucionalAsignado',
        'matriculaAprobada',

        'codigoSolicitud',
        'aceptacionLegal',
        'aceptaTerminos',
        'aceptaCambiosDevoluciones',
        'aceptaPrivacidad',
        'aceptacionLegalVersion',
        'tarifarioSnapshot',

        'userAgent',
        'pageUrl',
        'createdAt',
        'updatedAt'
      ]);
    }

    function isOfficialProgramId(programId) {
      return programId in [
        'nostra-360-uni',
        'nostra-power-uni',
        'nostra-elite-uni',
        'nostra-prime-uni',
        'nostra-talentum-uni',
        'ciclo-ien',
        'proyecto-escolar',
        'paralelo-cepre-uni',
        'ciclo-verano-uni'
      ];
    }

    function validPreApplicant(d) {
      return d.nombre is string
        && d.nombre.size() >= 5
        && d.nombre.size() <= 100
        && d.dni is string
        && d.dni.size() >= 8
        && d.dni.size() <= 12
        && d.celular is string
        && d.celular.size() >= 9
        && d.celular.size() <= 20
        && d.correo is string
        && d.correo.size() >= 6
        && d.correo.size() <= 100
        && d.colegio is string
        && d.colegio.size() <= 150
        && d.situacion is string
        && d.situacion.size() <= 80
        && d.apoderado is string
        && d.apoderado.size() <= 100
        && d.celularApoderado is string
        && d.celularApoderado.size() <= 20
        && d.comentario is string
        && d.comentario.size() <= 1000
        && d.confirmacion is string
        && d.confirmacion.size() >= 5
        && d.confirmacion.size() <= 300;
    }

    function validPreProgram(d) {
      return isOfficialProgramId(d.programaId)
        && d.ciclo is string
        && d.ciclo.size() >= 3
        && d.ciclo.size() <= 100
        && d.planId is string
        && d.planId.size() >= 1
        && d.planId.size() <= 80
        && d.planNombre is string
        && d.planNombre.size() >= 1
        && d.planNombre.size() <= 100
        && d.modalidad in [
          'Presencial',
          'Virtual',
          'Mixta'
        ]
        && d.turno is string
        && d.turno.size() >= 1
        && d.turno.size() <= 80;
    }

    function validPreAmounts(d) {
      return d.precioReferencia is number
        && d.precioReferencia > 0
        && d.precioReferencia <= 100000
        && d.matriculaReferencia is number
        && d.matriculaReferencia >= 0
        && d.matriculaReferencia <= 100000
        && d.tipoCobroReferencia in [
          'mensual',
          'unico'
        ]
        && d.cobroInicial in [
          'matricula_y_primera_cuota',
          'solo_matricula',
          'primera_cuota',
          'pago_total'
        ]
        && d.conceptoPagoInicial is string
        && d.conceptoPagoInicial.size() >= 3
        && d.conceptoPagoInicial.size() <= 100
        && d.totalInicial is number
        && d.totalInicial > 0
        && d.totalInicial <= 100000
        && d.montoPagoInicial is number
        && d.montoPagoInicial == d.totalInicial
        && d.montoPagoInicialCentimos is int
        && d.montoPagoInicialCentimos > 0
        && d.montoPagoInicialCentimos <= 10000000
        && d.moneda == 'PEN'
        && d.detallePagosPosteriores is string
        && d.detallePagosPosteriores.size() >= 3
        && d.detallePagosPosteriores.size() <= 500;
    }

    function validPrePaymentMethod(d) {
      return (
          d.metodoPagoPreferido == 'voucher_whatsapp'
          && d.metodoPagoLabel == 'Voucher por WhatsApp'
          && d.estadoPago == 'pendiente_envio_voucher'
        )
        || (
          d.metodoPagoPreferido == 'pago_online'
          && d.metodoPagoLabel == 'Pago en línea'
          && d.estadoPago == 'pendiente_pago_online'
        );
    }

    function validPreInitialState(d) {
      return validPrePaymentMethod(d)
        && d.pagoValidado == false
        && d.pagoObservacion is string
        && d.pagoObservacion == ''
        && d.precioValidadoServidor == false
        && d.estadoPrecio == 'pendiente_validacion_servidor'
        && d.intentoPagoCreado == false
        && d.asesorAsignado is string
        && d.asesorAsignado == ''
        && d.estado == 'nuevo'
        && d.origen == 'web_preinscripcion'
        && d.tipo == 'preinscripcion_inicial'
        && d.lineaAcademica == 'Nostra UNI Premium'
        && d.correoInstitucionalAsignado == false
        && d.matriculaAprobada == false;
    }

    function validPreLegal(d) {
      return d.codigoSolicitud is string
        && d.codigoSolicitud.matches(
          '^PRE-[0-9]{4}-[A-Z0-9]{8}$'
        )
        && d.aceptacionLegal is map
        && d.aceptacionLegal.terminos == true
        && d.aceptacionLegal.cambiosDevoluciones == true
        && d.aceptacionLegal.privacidad == true
        && d.aceptacionLegal.version == '2026-07-25'
        && d.aceptacionLegal.fechaCliente is string
        && d.aceptacionLegal.fechaCliente.size() >= 20
        && d.aceptacionLegal.fechaCliente.size() <= 40
        && d.aceptaTerminos == true
        && d.aceptaCambiosDevoluciones == true
        && d.aceptaPrivacidad == true
        && d.aceptacionLegalVersion == '2026-07-25';
    }

    function validPreSnapshot(d) {
      return d.tarifarioSnapshot is map
        && d.tarifarioSnapshot.programaId == d.programaId
        && d.tarifarioSnapshot.programaNombre == d.ciclo
        && d.tarifarioSnapshot.planId == d.planId
        && d.tarifarioSnapshot.planNombre == d.planNombre
        && d.tarifarioSnapshot.modalidad == d.modalidad
        && d.tarifarioSnapshot.turno == d.turno
        && d.tarifarioSnapshot.tipoCobro == d.tipoCobroReferencia
        && d.tarifarioSnapshot.cobroInicial == d.cobroInicial
        && d.tarifarioSnapshot.conceptoInicial == d.conceptoPagoInicial
        && d.tarifarioSnapshot.precioAplicado == d.precioReferencia
        && d.tarifarioSnapshot.matricula == d.matriculaReferencia
        && d.tarifarioSnapshot.totalInicial == d.totalInicial
        && d.tarifarioSnapshot.totalInicialCentimos
          == d.montoPagoInicialCentimos
        && d.tarifarioSnapshot.moneda == d.moneda
        && d.tarifarioSnapshot.detallePagosPosteriores
          == d.detallePagosPosteriores;
    }

    function validPreTechnicalData(d) {
      return d.userAgent is string
        && d.userAgent.size() <= 1000
        && d.pageUrl is string
        && d.pageUrl.size() <= 1000
        && d.createdAt == request.time
        && d.updatedAt == request.time;
    }

    /*
     * PREINSCRIPCIONES
     */
    match /preinscripciones/{id} {

      allow create: if hasAllowedPreinscripcionFields(
          request.resource.data
        )
        && validPreApplicant(request.resource.data)
        && validPreProgram(request.resource.data)
        && validPreAmounts(request.resource.data)
        && validPreInitialState(request.resource.data)
        && validPreLegal(request.resource.data)
        && validPreSnapshot(request.resource.data)
        && validPreTechnicalData(request.resource.data);

      allow read, update, delete: if isAdmin();
    }

    /*
     * USUARIOS / NOSTRACUENTAS
     */
    match /users/{uid} {

      allow read: if isAdmin()
        || (
          request.auth != null
          && request.auth.uid == uid
        );

      allow create: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly([
          'uid',
          'username',
          'usernameLower',
          'authEmail',
          'institutionalEmail',
          'microsoftVerified',
          'name',
          'role',
          'roleLabel',
          'detail',
          'status',
          'blocked',
          'createdAt'
        ])

        && request.resource.data.uid == uid

        && request.resource.data.username is string
        && request.resource.data.username.size() >= 5
        && request.resource.data.username.size() <= 20

        && request.resource.data.usernameLower
          == request.resource.data.username

        && request.resource.data.authEmail is string
        && request.resource.data.authEmail.size() >= 10
        && request.resource.data.authEmail.size() <= 100

        && request.resource.data.institutionalEmail is string
        && request.resource.data.institutionalEmail.matches(
          '^[^@]+@gruponostradamus\\.edu\\.pe$'
        )

        && request.resource.data.microsoftVerified == true

        && request.resource.data.name is string
        && request.resource.data.name.size() >= 5
        && request.resource.data.name.size() <= 80

        && request.resource.data.role
          in ['student', 'teacher']

        && request.resource.data.roleLabel
          in ['Alumno', 'Docente']

        && request.resource.data.detail is string
        && request.resource.data.detail.size() >= 3
        && request.resource.data.detail.size() <= 80

        && request.resource.data.status == 'pending'
        && request.resource.data.blocked == false
        && request.resource.data.createdAt == request.time;

      allow update, delete: if isAdmin();
    }

    /*
     * NOMBRES DE USUARIO
     */
    match /usernames/{username} {

      allow read: if true;

      allow create: if request.auth != null
        && !exists(
          /databases/$(database)/documents/usernames/$(username)
        )
        && request.resource.data.keys().hasOnly([
          'uid',
          'institutionalEmail',
          'createdAt'
        ])

        && request.resource.data.uid == request.auth.uid

        && request.resource.data.institutionalEmail is string
        && request.resource.data.institutionalEmail.matches(
          '^[^@]+@gruponostradamus\\.edu\\.pe$'
        )

        && request.resource.data.createdAt == request.time;

      allow update, delete: if isAdmin();
    }

    /*
     * MENSAJES DE NOSTRACHAT
     */
    match /rooms/{roomId}/messages/{messageId} {

      allow read: if canReadRoom(roomId);

      allow create: if canCreateInRoom(roomId)
        && request.resource.data.keys().hasOnly([
          'text',
          'name',
          'extra',
          'zone',
          'roomId',
          'roomLabel',
          'sessionId',
          'type',
          'moderationStatus',
          'createdAt',

          'hasImage',
          'imageData',
          'imageMime',
          'imageWidth',
          'imageHeight',
          'imageSizeBytes',
          'imageOriginalName',
          'imageUrl',
          'imagePath',

          'damusVision',
          'sourceMessageId',
          'requestedBy',

          'pinned',
          'expiresAt'
        ])

        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 6000

        && request.resource.data.name is string
        && request.resource.data.name.size() >= 3
        && request.resource.data.name.size() <= 60

        && request.resource.data.extra is string
        && request.resource.data.extra.size() >= 3
        && request.resource.data.extra.size() <= 150

        && request.resource.data.roomId == roomId

        && request.resource.data.roomLabel is string
        && request.resource.data.roomLabel.size() >= 3
        && request.resource.data.roomLabel.size() <= 40

        && (
          (
            isAlumnoRoom(roomId)
            && request.resource.data.zone == 'alumnos'
          )
          ||
          (
            isExternoRoom(roomId)
            && request.resource.data.zone == 'externos'
          )
        )

        && request.resource.data.sessionId is string
        && request.resource.data.sessionId.size() <= 120

        && request.resource.data.type == 'message'
        && request.resource.data.moderationStatus == 'visible'

        && (
          !request.resource.data.keys().hasAny(['pinned'])
          || request.resource.data.pinned == false
        )

        && (
          !request.resource.data.keys().hasAny(['expiresAt'])
          || (
            request.resource.data.expiresAt is timestamp
            && request.resource.data.expiresAt > request.time
          )
        )

        && (
          !request.resource.data.keys().hasAny(['imageUrl'])
          || (
            request.resource.data.imageUrl is string
            && request.resource.data.imageUrl.size() <= 2000
          )
        )

        && (
          !request.resource.data.keys().hasAny(['imagePath'])
          || (
            request.resource.data.imagePath is string
            && request.resource.data.imagePath.size() <= 500
          )
        )

        && request.resource.data.createdAt == request.time;

      allow update, delete: if isAdmin();
    }

    /*
     * REPORTES
     */
    match /rooms/{roomId}/reports/{reportId} {

      allow read: if isAdmin();

      allow create: if canCreateInRoom(roomId)
        && request.resource.data.createdAt == request.time;

      allow update, delete: if isAdmin();
    }

    /*
     * PRESENCIA
     */
    match /rooms/{roomId}/presence/{sessionId} {

      allow read: if isOfficialRoom(roomId);

      allow create, update: if canCreateInRoom(roomId)
        && request.resource.data.lastSeen == request.time;

      allow delete: if isAdmin();
    }

    /*
     * PROGRAMAS, PLANES, PRECIOS, HORARIOS Y PROMOCIONES
     */
    match /programas_publicos/{programId} {

      allow read: if true;

      allow create, update: if isAdmin()
        && programId in [
          'nostra-360-uni',
          'nostra-power-uni',
          'nostra-elite-uni',
          'nostra-prime-uni',
          'nostra-talentum-uni',
          'ciclo-ien',
          'proyecto-escolar',
          'paralelo-cepre-uni',
          'ciclo-verano-uni'
        ];

      allow delete: if false;
    }

    /*
     * LIBRO DE RECLAMACIONES
     */
    match /libro_reclamaciones/{reclamoId} {

      /*
       * El formulario público puede crear una hoja.
       * No se permite lectura pública de reclamos.
       */
      allow create: if request.resource.data.keys().hasOnly([
        'codigo',
        'tipo',
        'consumidor',
        'apoderado',
        'servicio',
        'detalle',
        'pedido',
        'declaracionAceptada',
        'estado',
        'estadoAtencion',
        'respuestaAdministrativa',
        'responsable',
        'notificacionPendiente',
        'plazoMaximoDiasHabiles',
        'origen',
        'versionFormato',
        'pageUrl',
        'userAgent',
        'createdAt',
        'updatedAt'
      ])

      && request.resource.data.codigo is string
      && request.resource.data.codigo.matches(
        '^LR-[0-9]{4}-[A-Z0-9]{8}$'
      )

      && request.resource.data.tipo
        in ['reclamo', 'queja']

      && request.resource.data.consumidor is map
      && request.resource.data.consumidor.keys().hasOnly([
        'nombres',
        'tipoDocumento',
        'numeroDocumento',
        'correo',
        'celular',
        'direccion',
        'distrito',
        'ubicacion',
        'menorEdad'
      ])

      && request.resource.data.consumidor.nombres is string
      && request.resource.data.consumidor.nombres.size() >= 5
      && request.resource.data.consumidor.nombres.size() <= 120

      && request.resource.data.consumidor.tipoDocumento
        in ['DNI', 'CE', 'Pasaporte', 'Otro']

      && request.resource.data.consumidor.numeroDocumento is string
      && request.resource.data.consumidor.numeroDocumento.size() >= 6
      && request.resource.data.consumidor.numeroDocumento.size() <= 20

      && request.resource.data.consumidor.correo is string
      && request.resource.data.consumidor.correo.size() >= 5
      && request.resource.data.consumidor.correo.size() <= 120

      && request.resource.data.consumidor.celular is string
      && request.resource.data.consumidor.celular.size() >= 9
      && request.resource.data.consumidor.celular.size() <= 20

      && request.resource.data.consumidor.direccion is string
      && request.resource.data.consumidor.direccion.size() >= 5
      && request.resource.data.consumidor.direccion.size() <= 180

      && request.resource.data.consumidor.distrito is string
      && request.resource.data.consumidor.distrito.size() <= 80

      && request.resource.data.consumidor.ubicacion is string
      && request.resource.data.consumidor.ubicacion.size() <= 120

      && request.resource.data.consumidor.menorEdad is bool

      && request.resource.data.apoderado is map
      && request.resource.data.apoderado.keys().hasOnly([
        'nombres',
        'numeroDocumento',
        'correo',
        'celular'
      ])

      && request.resource.data.apoderado.nombres is string
      && request.resource.data.apoderado.nombres.size() <= 120

      && request.resource.data.apoderado.numeroDocumento is string
      && request.resource.data.apoderado.numeroDocumento.size() <= 20

      && request.resource.data.apoderado.correo is string
      && request.resource.data.apoderado.correo.size() <= 120

      && request.resource.data.apoderado.celular is string
      && request.resource.data.apoderado.celular.size() <= 20

      && (
        (
          request.resource.data.consumidor.menorEdad == true

          && request.resource.data.apoderado.nombres.size() >= 5
          && request.resource.data.apoderado.numeroDocumento.size() >= 6
          && request.resource.data.apoderado.correo.size() >= 5
          && request.resource.data.apoderado.celular.size() >= 9
        )
        ||
        (
          request.resource.data.consumidor.menorEdad == false

          && request.resource.data.apoderado.nombres == ''
          && request.resource.data.apoderado.numeroDocumento == ''
          && request.resource.data.apoderado.correo == ''
          && request.resource.data.apoderado.celular == ''
        )
      )

      && request.resource.data.servicio is map
      && request.resource.data.servicio.keys().hasOnly([
        'tipo',
        'nombre',
        'fecha',
        'monto',
        'comprobante'
      ])

      && request.resource.data.servicio.tipo
        == 'servicio educativo'

      && request.resource.data.servicio.nombre is string
      && request.resource.data.servicio.nombre.size() >= 3
      && request.resource.data.servicio.nombre.size() <= 160

      && request.resource.data.servicio.fecha is string
      && request.resource.data.servicio.fecha.size() <= 10

      && request.resource.data.servicio.monto is number
      && request.resource.data.servicio.monto >= 0
      && request.resource.data.servicio.monto <= 100000

      && request.resource.data.servicio.comprobante is string
      && request.resource.data.servicio.comprobante.size() <= 100

      && request.resource.data.detalle is string
      && request.resource.data.detalle.size() >= 20
      && request.resource.data.detalle.size() <= 4000

      && request.resource.data.pedido is string
      && request.resource.data.pedido.size() >= 10
      && request.resource.data.pedido.size() <= 2000

      && request.resource.data.declaracionAceptada == true

      && request.resource.data.estado == 'recibido'
      && request.resource.data.estadoAtencion == 'pendiente'

      && request.resource.data.respuestaAdministrativa is string
      && request.resource.data.respuestaAdministrativa == ''

      && request.resource.data.responsable is string
      && request.resource.data.responsable == ''

      && request.resource.data.notificacionPendiente == true
      && request.resource.data.plazoMaximoDiasHabiles == 15

      && request.resource.data.origen
        == 'libro_reclamaciones_web'

      && request.resource.data.versionFormato
        == '2026-01'

      && request.resource.data.pageUrl is string
      && request.resource.data.pageUrl.size() <= 1000

      && request.resource.data.userAgent is string
      && request.resource.data.userAgent.size() <= 1000

      && request.resource.data.createdAt == request.time
      && request.resource.data.updatedAt == request.time;

      /*
       * Solo el administrador puede leer y actualizar
       * los registros del Libro de Reclamaciones.
       */
      allow read, update: if isAdmin();

      /*
       * Los reclamos no se eliminan desde la web.
       */
      allow delete: if false;
    }

    /*
     * FINANZAS ADMINISTRATIVAS
     */
    function validFinanceClosureAccount(a) {
      return a is map
        && a.keys().hasAll([
          'saldoInicialCentimos',
          'entradasCentimos',
          'salidasCentimos',
          'saldoEsperadoCentimos',
          'saldoRealCentimos',
          'diferenciaCentimos'
        ])
        && a.keys().hasOnly([
          'saldoInicialCentimos',
          'entradasCentimos',
          'salidasCentimos',
          'saldoEsperadoCentimos',
          'saldoRealCentimos',
          'diferenciaCentimos'
        ])
        && a.saldoInicialCentimos is int
        && a.saldoInicialCentimos >= -100000000000
        && a.saldoInicialCentimos <= 100000000000
        && a.entradasCentimos is int
        && a.entradasCentimos >= 0
        && a.entradasCentimos <= 100000000000
        && a.salidasCentimos is int
        && a.salidasCentimos >= 0
        && a.salidasCentimos <= 100000000000
        && a.saldoEsperadoCentimos is int
        && a.saldoEsperadoCentimos >= -100000000000
        && a.saldoEsperadoCentimos <= 100000000000
        && a.saldoRealCentimos is int
        && a.saldoRealCentimos >= -100000000000
        && a.saldoRealCentimos <= 100000000000
        && a.diferenciaCentimos is int
        && a.diferenciaCentimos >= -100000000000
        && a.diferenciaCentimos <= 100000000000
        && a.saldoEsperadoCentimos
          == a.saldoInicialCentimos
            + a.entradasCentimos
            - a.salidasCentimos
        && a.diferenciaCentimos
          == a.saldoRealCentimos
            - a.saldoEsperadoCentimos;
    }

    function validFinanceClosureAccounts(c) {
      return c is map
        && c.keys().hasAll([
          'caja_efectivo',
          'yape',
          'plin',
          'bcp',
          'culqi',
          'otra'
        ])
        && c.keys().hasOnly([
          'caja_efectivo',
          'yape',
          'plin',
          'bcp',
          'culqi',
          'otra'
        ])
        && validFinanceClosureAccount(c.caja_efectivo)
        && validFinanceClosureAccount(c.yape)
        && validFinanceClosureAccount(c.plin)
        && validFinanceClosureAccount(c.bcp)
        && validFinanceClosureAccount(c.culqi)
        && validFinanceClosureAccount(c.otra);
    }

    match /finanzas_movimientos/{movimientoId} {

      allow read: if isAdmin();

      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly([
          'tipo',
          'fechaOperacion',
          'categoria',
          'concepto',
          'monto',
          'metodoPago',
          'cuenta',
          'numeroOperacion',
          'observacion',
          'estado',
          'origen',
          'creadoPor',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.tipo in ['ingreso', 'egreso']
        && request.resource.data.fechaOperacion is string
        && request.resource.data.fechaOperacion.size() == 10
        && request.resource.data.categoria is string
        && request.resource.data.categoria.size() >= 3
        && request.resource.data.categoria.size() <= 60
        && request.resource.data.concepto is string
        && request.resource.data.concepto.size() >= 3
        && request.resource.data.concepto.size() <= 160
        && request.resource.data.monto is number
        && request.resource.data.monto > 0
        && request.resource.data.monto <= 1000000
        && request.resource.data.metodoPago in [
          'efectivo',
          'yape',
          'plin',
          'transferencia',
          'culqi',
          'otro'
        ]
        && request.resource.data.cuenta in [
          'caja_efectivo',
          'yape',
          'plin',
          'bcp',
          'culqi',
          'otra'
        ]
        && request.resource.data.numeroOperacion is string
        && request.resource.data.numeroOperacion.size() <= 100
        && request.resource.data.observacion is string
        && request.resource.data.observacion.size() <= 1000
        && request.resource.data.estado == 'activo'
        && request.resource.data.origen == 'manual_admin'
        && request.resource.data.creadoPor
          == request.auth.token.email
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      /*
       * Única modificación permitida: pasar de activo a anulado.
       * El movimiento original permanece y debe generarse simultáneamente
       * su documento de auditoría con el mismo identificador.
       */
      allow update: if isAdmin()
        && resource.data.estado == 'activo'
        && request.resource.data.estado == 'anulado'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'estado',
          'motivoAnulacion',
          'anuladoPor',
          'anuladoEn',
          'updatedAt'
        ])
        && request.resource.data.motivoAnulacion is string
        && request.resource.data.motivoAnulacion.size() >= 5
        && request.resource.data.motivoAnulacion.size() <= 500
        && request.resource.data.anuladoPor
          == request.auth.token.email
        && request.resource.data.anuladoEn == request.time
        && request.resource.data.updatedAt == request.time
        && getAfter(
          /databases/$(database)/documents/finanzas_auditoria/$(movimientoId)
        ).data.movimientoId == movimientoId
        && getAfter(
          /databases/$(database)/documents/finanzas_auditoria/$(movimientoId)
        ).data.accion == 'anulacion';

      allow delete: if false;
    }

    /*
     * AUDITORÍA FINANCIERA
     * Un documento por movimiento anulado. No puede editarse ni borrarse.
     */
    match /finanzas_auditoria/{auditoriaId} {

      allow read: if isAdmin();

      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly([
          'movimientoId',
          'accion',
          'motivo',
          'estadoAnterior',
          'estadoNuevo',
          'ejecutadoPor',
          'fechaOperacion',
          'tipo',
          'categoria',
          'concepto',
          'monto',
          'cuenta',
          'numeroOperacion',
          'origen',
          'createdAt'
        ])
        && request.resource.data.movimientoId == auditoriaId
        && request.resource.data.accion == 'anulacion'
        && request.resource.data.motivo is string
        && request.resource.data.motivo.size() >= 5
        && request.resource.data.motivo.size() <= 500
        && request.resource.data.estadoAnterior == 'activo'
        && request.resource.data.estadoNuevo == 'anulado'
        && request.resource.data.ejecutadoPor
          == request.auth.token.email
        && request.resource.data.fechaOperacion is string
        && request.resource.data.fechaOperacion.size() == 10
        && request.resource.data.tipo in ['ingreso', 'egreso']
        && request.resource.data.categoria is string
        && request.resource.data.categoria.size() >= 3
        && request.resource.data.categoria.size() <= 60
        && request.resource.data.concepto is string
        && request.resource.data.concepto.size() >= 3
        && request.resource.data.concepto.size() <= 160
        && request.resource.data.monto is number
        && request.resource.data.monto > 0
        && request.resource.data.monto <= 1000000
        && request.resource.data.cuenta in [
          'caja_efectivo',
          'yape',
          'plin',
          'bcp',
          'culqi',
          'otra'
        ]
        && request.resource.data.numeroOperacion is string
        && request.resource.data.numeroOperacion.size() <= 100
        && request.resource.data.origen == 'manual_admin'
        && request.resource.data.createdAt == request.time
        && get(
          /databases/$(database)/documents/finanzas_movimientos/$(auditoriaId)
        ).data.estado == 'activo'
        && getAfter(
          /databases/$(database)/documents/finanzas_movimientos/$(auditoriaId)
        ).data.estado == 'anulado'
        && request.resource.data.fechaOperacion == get(
          /databases/$(database)/documents/finanzas_movimientos/$(auditoriaId)
        ).data.fechaOperacion
        && request.resource.data.tipo == get(
          /databases/$(database)/documents/finanzas_movimientos/$(auditoriaId)
        ).data.tipo
        && request.resource.data.categoria == get(
          /databases/$(database)/documents/finanzas_movimientos/$(auditoriaId)
        ).data.categoria
        && request.resource.data.concepto == get(
          /databases/$(database)/documents/finanzas_movimientos/$(auditoriaId)
        ).data.concepto
        && request.resource.data.monto == get(
          /databases/$(database)/documents/finanzas_movimientos/$(auditoriaId)
        ).data.monto
        && request.resource.data.cuenta == get(
          /databases/$(database)/documents/finanzas_movimientos/$(auditoriaId)
        ).data.cuenta
        && request.resource.data.numeroOperacion == get(
          /databases/$(database)/documents/finanzas_movimientos/$(auditoriaId)
        ).data.numeroOperacion
        && request.resource.data.origen == get(
          /databases/$(database)/documents/finanzas_movimientos/$(auditoriaId)
        ).data.origen;

      allow update, delete: if false;
    }

    /*
     * CIERRES DIARIOS Y CONCILIACIÓN
     * Un cierre inmutable por fecha, identificado por YYYY-MM-DD.
     */
    match /finanzas_cierres/{cierreId} {

      allow read: if isAdmin();

      allow create: if isAdmin()
        && !exists(
          /databases/$(database)/documents/finanzas_cierres/$(cierreId)
        )
        && request.resource.data.keys().hasAll([
          'fechaCierre',
          'estado',
          'cuentas',
          'totalIngresosDiaCentimos',
          'totalEgresosDiaCentimos',
          'operacionesDia',
          'saldoEsperadoTotalCentimos',
          'saldoRealTotalCentimos',
          'diferenciaTotalCentimos',
          'tieneDiferencia',
          'observacion',
          'cerradoPor',
          'origen',
          'version',
          'closedAt',
          'createdAt'
        ])
        && request.resource.data.keys().hasOnly([
          'fechaCierre',
          'estado',
          'cuentas',
          'totalIngresosDiaCentimos',
          'totalEgresosDiaCentimos',
          'operacionesDia',
          'saldoEsperadoTotalCentimos',
          'saldoRealTotalCentimos',
          'diferenciaTotalCentimos',
          'tieneDiferencia',
          'observacion',
          'cerradoPor',
          'origen',
          'version',
          'closedAt',
          'createdAt'
        ])
        && request.resource.data.fechaCierre is string
        && request.resource.data.fechaCierre.size() == 10
        && request.resource.data.fechaCierre.matches(
          '^[0-9]{4}-[0-9]{2}-[0-9]{2}$'
        )
        && request.resource.data.fechaCierre == cierreId
        && request.resource.data.estado == 'cerrado'
        && validFinanceClosureAccounts(
          request.resource.data.cuentas
        )
        && request.resource.data.totalIngresosDiaCentimos is int
        && request.resource.data.totalIngresosDiaCentimos >= 0
        && request.resource.data.totalIngresosDiaCentimos
          <= 100000000000
        && request.resource.data.totalEgresosDiaCentimos is int
        && request.resource.data.totalEgresosDiaCentimos >= 0
        && request.resource.data.totalEgresosDiaCentimos
          <= 100000000000
        && request.resource.data.operacionesDia is int
        && request.resource.data.operacionesDia >= 0
        && request.resource.data.operacionesDia <= 100000
        && request.resource.data.saldoEsperadoTotalCentimos is int
        && request.resource.data.saldoRealTotalCentimos is int
        && request.resource.data.diferenciaTotalCentimos is int
        && request.resource.data.saldoEsperadoTotalCentimos
          == request.resource.data.cuentas.caja_efectivo.saldoEsperadoCentimos
            + request.resource.data.cuentas.yape.saldoEsperadoCentimos
            + request.resource.data.cuentas.plin.saldoEsperadoCentimos
            + request.resource.data.cuentas.bcp.saldoEsperadoCentimos
            + request.resource.data.cuentas.culqi.saldoEsperadoCentimos
            + request.resource.data.cuentas.otra.saldoEsperadoCentimos
        && request.resource.data.saldoRealTotalCentimos
          == request.resource.data.cuentas.caja_efectivo.saldoRealCentimos
            + request.resource.data.cuentas.yape.saldoRealCentimos
            + request.resource.data.cuentas.plin.saldoRealCentimos
            + request.resource.data.cuentas.bcp.saldoRealCentimos
            + request.resource.data.cuentas.culqi.saldoRealCentimos
            + request.resource.data.cuentas.otra.saldoRealCentimos
        && request.resource.data.diferenciaTotalCentimos
          == request.resource.data.saldoRealTotalCentimos
            - request.resource.data.saldoEsperadoTotalCentimos
        && request.resource.data.tieneDiferencia is bool
        && request.resource.data.tieneDiferencia
          == (request.resource.data.diferenciaTotalCentimos != 0)
        && request.resource.data.observacion is string
        && request.resource.data.observacion.size() <= 1000
        && (
          request.resource.data.diferenciaTotalCentimos == 0
          || request.resource.data.observacion.size() >= 5
        )
        && request.resource.data.cerradoPor
          == request.auth.token.email
        && request.resource.data.origen == 'cierre_diario_admin'
        && request.resource.data.version == '2026-08'
        && request.resource.data.closedAt == request.time
        && request.resource.data.createdAt == request.time;

      allow update, delete: if false;
    }

    /*
     * PAGOS DE ALUMNOS INTEGRADOS CON FINANZAS
     */
    match /finanzas_movimientos/{movimientoId} {
      allow create: if isAdmin()
        && request.resource.data.keys().hasAll([
          'tipo',
          'fechaOperacion',
          'categoria',
          'concepto',
          'monto',
          'metodoPago',
          'cuenta',
          'numeroOperacion',
          'observacion',
          'estado',
          'origen',
          'creadoPor',
          'pagoId',
          'preinscripcionId',
          'registroAlumnoId',
          'matriculaId',
          'grupoId',
          'alumnoNombre',
          'alumnoDni',
          'conceptoPago',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'tipo',
          'fechaOperacion',
          'categoria',
          'concepto',
          'monto',
          'metodoPago',
          'cuenta',
          'numeroOperacion',
          'observacion',
          'estado',
          'origen',
          'creadoPor',
          'pagoId',
          'preinscripcionId',
          'registroAlumnoId',
          'matriculaId',
          'grupoId',
          'alumnoNombre',
          'alumnoDni',
          'conceptoPago',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.tipo == 'ingreso'
        && request.resource.data.fechaOperacion is string
        && request.resource.data.fechaOperacion.size() == 10
        && request.resource.data.categoria
          in ['matricula', 'pension', 'otros_ingresos']
        && request.resource.data.concepto is string
        && request.resource.data.concepto.size() >= 3
        && request.resource.data.concepto.size() <= 160
        && request.resource.data.monto is number
        && request.resource.data.monto > 0
        && request.resource.data.monto <= 1000000
        && request.resource.data.metodoPago in [
          'efectivo',
          'yape',
          'plin',
          'transferencia',
          'culqi',
          'otro'
        ]
        && request.resource.data.cuenta in [
          'caja_efectivo',
          'yape',
          'plin',
          'bcp',
          'culqi',
          'otra'
        ]
        && request.resource.data.numeroOperacion is string
        && request.resource.data.numeroOperacion.size() >= 3
        && request.resource.data.numeroOperacion.size() <= 100
        && request.resource.data.observacion is string
        && request.resource.data.observacion.size() <= 1000
        && request.resource.data.estado == 'activo'
        && request.resource.data.origen == 'pago_alumno_admin'
        && request.resource.data.creadoPor
          == request.auth.token.email
        && request.resource.data.pagoId == movimientoId
        && request.resource.data.preinscripcionId is string
        && request.resource.data.preinscripcionId.size() >= 5
        && request.resource.data.preinscripcionId.size() <= 160
        && request.resource.data.registroAlumnoId
          == request.resource.data.preinscripcionId
        && request.resource.data.matriculaId
          == request.resource.data.preinscripcionId
        && request.resource.data.grupoId is string
        && request.resource.data.grupoId.size() >= 3
        && request.resource.data.grupoId.size() <= 200
        && request.resource.data.alumnoNombre is string
        && request.resource.data.alumnoNombre.size() >= 5
        && request.resource.data.alumnoNombre.size() <= 160
        && request.resource.data.alumnoDni is string
        && request.resource.data.alumnoDni.size() >= 6
        && request.resource.data.alumnoDni.size() <= 20
        && request.resource.data.conceptoPago is string
        && request.resource.data.conceptoPago.size() >= 3
        && request.resource.data.conceptoPago.size() <= 150
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && getAfter(
          /databases/$(database)/documents/preinscripciones/$(request.resource.data.preinscripcionId)
        ).data.pagoValidado == true
        && getAfter(
          /databases/$(database)/documents/preinscripciones/$(request.resource.data.preinscripcionId)
        ).data.estadoPago == 'pago_validado'
        && getAfter(
          /databases/$(database)/documents/preinscripciones/$(request.resource.data.preinscripcionId)
        ).data.ingresoFinancieroId == movimientoId
        && getAfter(
          /databases/$(database)/documents/preinscripciones/$(request.resource.data.preinscripcionId)
        ).data.registroAlumnoId
          == request.resource.data.registroAlumnoId
        && getAfter(
          /databases/$(database)/documents/preinscripciones/$(request.resource.data.preinscripcionId)
        ).data.grupoId == request.resource.data.grupoId;
    }

    /*
     * Auditoría de movimientos creados desde pagos de alumnos.
     */
    match /finanzas_auditoria/{auditoriaId} {
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly([
          'movimientoId',
          'accion',
          'motivo',
          'estadoAnterior',
          'estadoNuevo',
          'ejecutadoPor',
          'fechaOperacion',
          'tipo',
          'categoria',
          'concepto',
          'monto',
          'cuenta',
          'numeroOperacion',
          'origen',
          'createdAt'
        ])
        && request.resource.data.movimientoId == auditoriaId
        && request.resource.data.accion == 'anulacion'
        && request.resource.data.motivo is string
        && request.resource.data.motivo.size() >= 5
        && request.resource.data.motivo.size() <= 500
        && request.resource.data.estadoAnterior == 'activo'
        && request.resource.data.estadoNuevo == 'anulado'
        && request.resource.data.ejecutadoPor
          == request.auth.token.email
        && request.resource.data.fechaOperacion is string
        && request.resource.data.fechaOperacion.size() == 10
        && request.resource.data.tipo == 'ingreso'
        && request.resource.data.categoria is string
        && request.resource.data.concepto is string
        && request.resource.data.monto is number
        && request.resource.data.monto > 0
        && request.resource.data.cuenta in [
          'caja_efectivo',
          'yape',
          'plin',
          'bcp',
          'culqi',
          'otra'
        ]
        && request.resource.data.numeroOperacion is string
        && request.resource.data.origen == 'pago_alumno_admin'
        && request.resource.data.createdAt == request.time
        && get(
          /databases/$(database)/documents/finanzas_movimientos/$(auditoriaId)
        ).data.estado == 'activo'
        && get(
          /databases/$(database)/documents/finanzas_movimientos/$(auditoriaId)
        ).data.origen == 'pago_alumno_admin'
        && getAfter(
          /databases/$(database)/documents/finanzas_movimientos/$(auditoriaId)
        ).data.estado == 'anulado'
        && request.resource.data.fechaOperacion == get(
          /databases/$(database)/documents/finanzas_movimientos/$(auditoriaId)
        ).data.fechaOperacion
        && request.resource.data.tipo == get(
          /databases/$(database)/documents/finanzas_movimientos/$(auditoriaId)
        ).data.tipo
        && request.resource.data.categoria == get(
          /databases/$(database)/documents/finanzas_movimientos/$(auditoriaId)
        ).data.categoria
        && request.resource.data.concepto == get(
          /databases/$(database)/documents/finanzas_movimientos/$(auditoriaId)
        ).data.concepto
        && request.resource.data.monto == get(
          /databases/$(database)/documents/finanzas_movimientos/$(auditoriaId)
        ).data.monto
        && request.resource.data.cuenta == get(
          /databases/$(database)/documents/finanzas_movimientos/$(auditoriaId)
        ).data.cuenta
        && request.resource.data.numeroOperacion == get(
          /databases/$(database)/documents/finanzas_movimientos/$(auditoriaId)
        ).data.numeroOperacion;
    }

    /*
     * GRUPOS, REGISTROS DE ALUMNOS Y MATRÍCULAS
     */
    match /grupos_academicos/{grupoId} {
      allow read: if isAdmin();
      allow create, update: if isAdmin()
        && request.resource.data.grupoId == grupoId;
      allow delete: if false;
    }

    match /registros_alumnos/{registroId} {
      allow read: if isAdmin();
      allow create, update: if isAdmin()
        && request.resource.data.registroAlumnoId == registroId
        && request.resource.data.preinscripcionId == registroId;
      allow delete: if false;
    }

    match /matriculas/{matriculaId} {
      allow read: if isAdmin();
      allow create, update: if isAdmin()
        && request.resource.data.matriculaId == matriculaId
        && request.resource.data.preinscripcionId == matriculaId
        && request.resource.data.registroAlumnoId == matriculaId;
      allow delete: if false;
    }

    /*
     * CRONOGRAMAS MANUALES DE CUOTAS POR ALUMNO
     */
    match /alumno_cuotas/{cuotaId} {
      allow read: if isAdmin();

      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly([
          'cuotaId',
          'preinscripcionId',
          'registroAlumnoId',
          'matriculaId',
          'alumnoNombre',
          'alumnoDni',
          'grupoId',
          'concepto',
          'numeroCuota',
          'montoProgramadoCentimos',
          'montoPagadoCentimos',
          'saldoPendienteCentimos',
          'fechaVencimiento',
          'estado',
          'origen',
          'creadoPor',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.cuotaId == cuotaId
        && request.resource.data.preinscripcionId is string
        && request.resource.data.preinscripcionId.size() >= 5
        && request.resource.data.preinscripcionId.size() <= 160
        && request.resource.data.registroAlumnoId
          == request.resource.data.preinscripcionId
        && request.resource.data.matriculaId
          == request.resource.data.preinscripcionId
        && request.resource.data.alumnoNombre is string
        && request.resource.data.alumnoNombre.size() >= 5
        && request.resource.data.alumnoNombre.size() <= 160
        && request.resource.data.alumnoDni is string
        && request.resource.data.alumnoDni.size() >= 6
        && request.resource.data.alumnoDni.size() <= 20
        && request.resource.data.grupoId is string
        && request.resource.data.grupoId.size() >= 3
        && request.resource.data.grupoId.size() <= 200
        && request.resource.data.concepto is string
        && request.resource.data.concepto.size() >= 3
        && request.resource.data.concepto.size() <= 150
        && request.resource.data.numeroCuota is int
        && request.resource.data.numeroCuota >= 1
        && request.resource.data.numeroCuota <= 100
        && request.resource.data.montoProgramadoCentimos is int
        && request.resource.data.montoProgramadoCentimos > 0
        && request.resource.data.montoProgramadoCentimos <= 100000000
        && request.resource.data.montoPagadoCentimos == 0
        && request.resource.data.saldoPendienteCentimos
          == request.resource.data.montoProgramadoCentimos
        && request.resource.data.fechaVencimiento is string
        && request.resource.data.fechaVencimiento.matches(
          '^[0-9]{4}-[0-9]{2}-[0-9]{2}$'
        )
        && request.resource.data.estado == 'pendiente'
        && request.resource.data.origen == 'cronograma_manual_admin'
        && request.resource.data.creadoPor
          == request.auth.token.email
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && (
          get(
            /databases/$(database)/documents/preinscripciones/$(request.resource.data.preinscripcionId)
          ).data.get('matriculaAprobada', false) == true
          || get(
            /databases/$(database)/documents/preinscripciones/$(request.resource.data.preinscripcionId)
          ).data.get('estado', '') == 'matriculado'
        );

      allow update: if isAdmin()
        && resource.data.estado in ['pendiente', 'parcial']
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'montoPagadoCentimos',
          'saldoPendienteCentimos',
          'estado',
          'ultimoAbonoId',
          'ultimoPagoAt',
          'updatedAt'
        ])
        && request.resource.data.montoProgramadoCentimos
          == resource.data.montoProgramadoCentimos
        && request.resource.data.montoPagadoCentimos is int
        && request.resource.data.montoPagadoCentimos
          > resource.data.montoPagadoCentimos
        && request.resource.data.montoPagadoCentimos
          <= resource.data.montoProgramadoCentimos
        && request.resource.data.saldoPendienteCentimos
          == request.resource.data.montoProgramadoCentimos
            - request.resource.data.montoPagadoCentimos
        && request.resource.data.estado
          == (
            request.resource.data.saldoPendienteCentimos == 0
              ? 'pagada'
              : 'parcial'
          )
        && request.resource.data.ultimoAbonoId is string
        && request.resource.data.ultimoAbonoId.size() >= 5
        && request.resource.data.ultimoAbonoId.size() <= 160
        && request.resource.data.ultimoPagoAt == request.time
        && request.resource.data.updatedAt == request.time
        && getAfter(
          /databases/$(database)/documents/alumno_abonos/$(request.resource.data.ultimoAbonoId)
        ).data.cuotaId == cuotaId
        && getAfter(
          /databases/$(database)/documents/alumno_abonos/$(request.resource.data.ultimoAbonoId)
        ).data.montoCentimos
          == request.resource.data.montoPagadoCentimos
            - resource.data.montoPagadoCentimos;

      allow delete: if false;
    }

    /*
     * ABONOS INMUTABLES DE CUOTAS
     */
    match /alumno_abonos/{abonoId} {
      allow read: if isAdmin();

      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly([
          'abonoId',
          'cuotaId',
          'preinscripcionId',
          'registroAlumnoId',
          'matriculaId',
          'alumnoNombre',
          'alumnoDni',
          'concepto',
          'montoCentimos',
          'fechaPago',
          'cuenta',
          'metodoPago',
          'numeroOperacion',
          'observacion',
          'movimientoFinancieroId',
          'estado',
          'origen',
          'registradoPor',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.abonoId == abonoId
        && request.resource.data.cuotaId is string
        && request.resource.data.cuotaId.size() >= 5
        && request.resource.data.cuotaId.size() <= 160
        && request.resource.data.preinscripcionId is string
        && request.resource.data.preinscripcionId.size() >= 5
        && request.resource.data.preinscripcionId.size() <= 160
        && request.resource.data.registroAlumnoId
          == request.resource.data.preinscripcionId
        && request.resource.data.matriculaId
          == request.resource.data.preinscripcionId
        && request.resource.data.alumnoNombre is string
        && request.resource.data.alumnoNombre.size() >= 5
        && request.resource.data.alumnoNombre.size() <= 160
        && request.resource.data.alumnoDni is string
        && request.resource.data.alumnoDni.size() >= 6
        && request.resource.data.alumnoDni.size() <= 20
        && request.resource.data.concepto is string
        && request.resource.data.concepto.size() >= 3
        && request.resource.data.concepto.size() <= 150
        && request.resource.data.montoCentimos is int
        && request.resource.data.montoCentimos > 0
        && request.resource.data.montoCentimos <= 100000000
        && request.resource.data.fechaPago is string
        && request.resource.data.fechaPago.matches(
          '^[0-9]{4}-[0-9]{2}-[0-9]{2}$'
        )
        && request.resource.data.cuenta in [
          'caja_efectivo',
          'yape',
          'plin',
          'bcp',
          'culqi',
          'otra'
        ]
        && request.resource.data.metodoPago in [
          'efectivo',
          'yape',
          'plin',
          'transferencia',
          'culqi',
          'otro'
        ]
        && request.resource.data.numeroOperacion is string
        && request.resource.data.numeroOperacion.size() >= 3
        && request.resource.data.numeroOperacion.size() <= 100
        && request.resource.data.observacion is string
        && request.resource.data.observacion.size() <= 1000
        && request.resource.data.movimientoFinancieroId
          == 'abono_' + abonoId
        && request.resource.data.estado == 'activo'
        && request.resource.data.origen == 'abono_cuota_admin'
        && request.resource.data.registradoPor
          == request.auth.token.email
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && get(
          /databases/$(database)/documents/alumno_cuotas/$(request.resource.data.cuotaId)
        ).data.preinscripcionId
          == request.resource.data.preinscripcionId
        && get(
          /databases/$(database)/documents/alumno_cuotas/$(request.resource.data.cuotaId)
        ).data.saldoPendienteCentimos
          >= request.resource.data.montoCentimos
        && getAfter(
          /databases/$(database)/documents/alumno_cuotas/$(request.resource.data.cuotaId)
        ).data.ultimoAbonoId == abonoId
        && getAfter(
          /databases/$(database)/documents/alumno_cuotas/$(request.resource.data.cuotaId)
        ).data.montoPagadoCentimos
          == get(
            /databases/$(database)/documents/alumno_cuotas/$(request.resource.data.cuotaId)
          ).data.montoPagadoCentimos
            + request.resource.data.montoCentimos
        && getAfter(
          /databases/$(database)/documents/finanzas_movimientos/$(request.resource.data.movimientoFinancieroId)
        ).data.abonoId == abonoId;

      allow update, delete: if false;
    }

    /*
     * INGRESOS FINANCIEROS ORIGINADOS POR ABONOS DE CUOTAS
     */
    match /finanzas_movimientos/{movimientoId} {
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly([
          'tipo',
          'fechaOperacion',
          'categoria',
          'concepto',
          'monto',
          'metodoPago',
          'cuenta',
          'numeroOperacion',
          'observacion',
          'estado',
          'origen',
          'creadoPor',
          'pagoId',
          'cuotaId',
          'abonoId',
          'preinscripcionId',
          'registroAlumnoId',
          'matriculaId',
          'grupoId',
          'alumnoNombre',
          'alumnoDni',
          'conceptoPago',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.tipo == 'ingreso'
        && request.resource.data.fechaOperacion is string
        && request.resource.data.fechaOperacion.matches(
          '^[0-9]{4}-[0-9]{2}-[0-9]{2}$'
        )
        && request.resource.data.categoria
          in ['matricula', 'pension', 'otros_ingresos']
        && request.resource.data.concepto is string
        && request.resource.data.concepto.size() >= 3
        && request.resource.data.concepto.size() <= 160
        && request.resource.data.monto is number
        && request.resource.data.monto > 0
        && request.resource.data.monto <= 1000000
        && request.resource.data.metodoPago in [
          'efectivo',
          'yape',
          'plin',
          'transferencia',
          'culqi',
          'otro'
        ]
        && request.resource.data.cuenta in [
          'caja_efectivo',
          'yape',
          'plin',
          'bcp',
          'culqi',
          'otra'
        ]
        && request.resource.data.numeroOperacion is string
        && request.resource.data.numeroOperacion.size() >= 3
        && request.resource.data.numeroOperacion.size() <= 100
        && request.resource.data.observacion is string
        && request.resource.data.observacion.size() <= 1000
        && request.resource.data.estado == 'activo'
        && request.resource.data.origen == 'abono_cuota_admin'
        && request.resource.data.creadoPor
          == request.auth.token.email
        && request.resource.data.pagoId == movimientoId
        && movimientoId == 'abono_' + request.resource.data.abonoId
        && request.resource.data.cuotaId is string
        && request.resource.data.cuotaId.size() >= 5
        && request.resource.data.abonoId is string
        && request.resource.data.abonoId.size() >= 5
        && request.resource.data.preinscripcionId is string
        && request.resource.data.preinscripcionId.size() >= 5
        && request.resource.data.registroAlumnoId
          == request.resource.data.preinscripcionId
        && request.resource.data.matriculaId
          == request.resource.data.preinscripcionId
        && request.resource.data.grupoId is string
        && request.resource.data.grupoId.size() >= 3
        && request.resource.data.grupoId.size() <= 200
        && request.resource.data.alumnoNombre is string
        && request.resource.data.alumnoNombre.size() >= 5
        && request.resource.data.alumnoNombre.size() <= 160
        && request.resource.data.alumnoDni is string
        && request.resource.data.alumnoDni.size() >= 6
        && request.resource.data.alumnoDni.size() <= 20
        && request.resource.data.conceptoPago is string
        && request.resource.data.conceptoPago.size() >= 3
        && request.resource.data.conceptoPago.size() <= 150
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && getAfter(
          /databases/$(database)/documents/alumno_abonos/$(request.resource.data.abonoId)
        ).data.movimientoFinancieroId == movimientoId
        && getAfter(
          /databases/$(database)/documents/alumno_abonos/$(request.resource.data.abonoId)
        ).data.cuotaId == request.resource.data.cuotaId
        && getAfter(
          /databases/$(database)/documents/alumno_abonos/$(request.resource.data.abonoId)
        ).data.montoCentimos
          == request.resource.data.monto * 100;
    }

    /*
     * TODO LO DEMÁS QUEDA BLOQUEADO
     */
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
