rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'fernandodaniel8888@gmail.com';
    }

    function isOfficialRoom(roomId) {
      return roomId in [
        'alumnos-general',
        'alumnos-matematica',
        'alumnos-fisica',
        'alumnos-quimica',
        'alumnos-aptitud-academica',
        'alumnos-humanidades',
        'externos-general',
        'externos-informes',
        'externos-orientacion-uni'
      ];
    }

    function isAlumnoRoom(roomId) {
      return roomId in [
        'alumnos-general',
        'alumnos-matematica',
        'alumnos-fisica',
        'alumnos-quimica',
        'alumnos-aptitud-academica',
        'alumnos-humanidades'
      ];
    }

    function isExternoRoom(roomId) {
      return roomId in [
        'externos-general',
        'externos-informes',
        'externos-orientacion-uni'
      ];
    }

    function hasUserProfile() {
      return request.auth != null
        && exists(
          /databases/$(database)/documents/users/$(request.auth.uid)
        );
    }

    function isActiveUser() {
      return hasUserProfile()
        && get(
          /databases/$(database)/documents/users/$(request.auth.uid)
        ).data.status == 'active'
        && get(
          /databases/$(database)/documents/users/$(request.auth.uid)
        ).data.blocked == false;
    }

    function canReadRoom(roomId) {
      return isOfficialRoom(roomId)
        && (
          isExternoRoom(roomId)
          || isAdmin()
          || isActiveUser()
        );
    }

    function canCreateInRoom(roomId) {
      return isOfficialRoom(roomId)
        && (
          isExternoRoom(roomId)
          || isAdmin()
          || isActiveUser()
        );
    }

    /*
     * FUNCIONES DE VALIDACIÓN PARA PREINSCRIPCIONES
     *
     * Se dividen en funciones pequeñas para evitar el error:
     * "Expression is too complex to evaluate safely".
     */
    function hasAllowedPreinscripcionFields(d) {
      return d.keys().hasOnly([
        'nombre',
        'dni',
        'celular',
        'correo',
        'colegio',
        'situacion',

        'programaId',
        'ciclo',
        'planId',
        'planNombre',
        'modalidad',
        'turno',

        'precioReferencia',
        'matriculaReferencia',
        'tipoCobroReferencia',
        'cobroInicial',
        'conceptoPagoInicial',
        'totalInicial',
        'montoPagoInicial',
        'montoPagoInicialCentimos',
        'moneda',
        'detallePagosPosteriores',

        'apoderado',
        'celularApoderado',
        'comentario',
        'confirmacion',

        'metodoPagoPreferido',
        'metodoPagoLabel',
        'estadoPago',
        'pagoValidado',
        'pagoObservacion',
        'precioValidadoServidor',
        'estadoPrecio',
        'intentoPagoCreado',
        'asesorAsignado',

        'estado',
        'origen',
        'tipo',
        'lineaAcademica',
        'correoInstitucionalAsignado',
        'matriculaAprobada',

        'codigoSolicitud',
        'aceptacionLegal',
        'aceptaTerminos',
        'aceptaCambiosDevoluciones',
        'aceptaPrivacidad',
        'aceptacionLegalVersion',
        'tarifarioSnapshot',

        'userAgent',
        'pageUrl',
        'createdAt',
        'updatedAt'
      ]);
    }

    function isOfficialProgramId(programId) {
      return programId in [
        'nostra-360-uni',
        'nostra-power-uni',
        'nostra-elite-uni',
        'nostra-prime-uni',
        'nostra-talentum-uni',
        'ciclo-ien',
        'proyecto-escolar',
        'paralelo-cepre-uni',
        'ciclo-verano-uni'
      ];
    }

    function validPreApplicant(d) {
      return d.nombre is string
        && d.nombre.size() >= 5
        && d.nombre.size() <= 100
        && d.dni is string
        && d.dni.size() >= 8
        && d.dni.size() <= 12
        && d.celular is string
        && d.celular.size() >= 9
        && d.celular.size() <= 20
        && d.correo is string
        && d.correo.size() >= 6
        && d.correo.size() <= 100
        && d.colegio is string
        && d.colegio.size() <= 150
        && d.situacion is string
        && d.situacion.size() <= 80
        && d.apoderado is string
        && d.apoderado.size() <= 100
        && d.celularApoderado is string
        && d.celularApoderado.size() <= 20
        && d.comentario is string
        && d.comentario.size() <= 1000
        && d.confirmacion is string
        && d.confirmacion.size() >= 5
        && d.confirmacion.size() <= 300;
    }

    function validPreProgram(d) {
      return isOfficialProgramId(d.programaId)
        && d.ciclo is string
        && d.ciclo.size() >= 3
        && d.ciclo.size() <= 100
        && d.planId is string
        && d.planId.size() >= 1
        && d.planId.size() <= 80
        && d.planNombre is string
        && d.planNombre.size() >= 1
        && d.planNombre.size() <= 100
        && d.modalidad in [
          'Presencial',
          'Virtual',
          'Mixta'
        ]
        && d.turno is string
        && d.turno.size() >= 1
        && d.turno.size() <= 80;
    }

    function validPreAmounts(d) {
      return d.precioReferencia is number
        && d.precioReferencia > 0
        && d.precioReferencia <= 100000
        && d.matriculaReferencia is number
        && d.matriculaReferencia >= 0
        && d.matriculaReferencia <= 100000
        && d.tipoCobroReferencia in [
          'mensual',
          'unico'
        ]
        && d.cobroInicial in [
          'matricula_y_primera_cuota',
          'solo_matricula',
          'primera_cuota',
          'pago_total'
        ]
        && d.conceptoPagoInicial is string
        && d.conceptoPagoInicial.size() >= 3
        && d.conceptoPagoInicial.size() <= 100
        && d.totalInicial is number
        && d.totalInicial > 0
        && d.totalInicial <= 100000
        && d.montoPagoInicial is number
        && d.montoPagoInicial == d.totalInicial
        && d.montoPagoInicialCentimos is int
        && d.montoPagoInicialCentimos > 0
        && d.montoPagoInicialCentimos <= 10000000
        && d.moneda == 'PEN'
        && d.detallePagosPosteriores is string
        && d.detallePagosPosteriores.size() >= 3
        && d.detallePagosPosteriores.size() <= 500;
    }

    function validPrePaymentMethod(d) {
      return (
          d.metodoPagoPreferido == 'voucher_whatsapp'
          && d.metodoPagoLabel == 'Voucher por WhatsApp'
          && d.estadoPago == 'pendiente_envio_voucher'
        )
        || (
          d.metodoPagoPreferido == 'pago_online'
          && d.metodoPagoLabel == 'Pago en línea'
          && d.estadoPago == 'pendiente_pago_online'
        );
    }

    function validPreInitialState(d) {
      return validPrePaymentMethod(d)
        && d.pagoValidado == false
        && d.pagoObservacion is string
        && d.pagoObservacion == ''
        && d.precioValidadoServidor == false
        && d.estadoPrecio == 'pendiente_validacion_servidor'
        && d.intentoPagoCreado == false
        && d.asesorAsignado is string
        && d.asesorAsignado == ''
        && d.estado == 'nuevo'
        && d.origen == 'web_preinscripcion'
        && d.tipo == 'preinscripcion_inicial'
        && d.lineaAcademica == 'Nostra UNI Premium'
        && d.correoInstitucionalAsignado == false
        && d.matriculaAprobada == false;
    }

    function validPreLegal(d) {
      return d.codigoSolicitud is string
        && d.codigoSolicitud.matches(
          '^PRE-[0-9]{4}-[A-Z0-9]{8}$'
        )
        && d.aceptacionLegal is map
        && d.aceptacionLegal.terminos == true
        && d.aceptacionLegal.cambiosDevoluciones == true
        && d.aceptacionLegal.privacidad == true
        && d.aceptacionLegal.version == '2026-07-25'
        && d.aceptacionLegal.fechaCliente is string
        && d.aceptacionLegal.fechaCliente.size() >= 20
        && d.aceptacionLegal.fechaCliente.size() <= 40
        && d.aceptaTerminos == true
        && d.aceptaCambiosDevoluciones == true
        && d.aceptaPrivacidad == true
        && d.aceptacionLegalVersion == '2026-07-25';
    }

    function validPreSnapshot(d) {
      return d.tarifarioSnapshot is map
        && d.tarifarioSnapshot.programaId == d.programaId
        && d.tarifarioSnapshot.programaNombre == d.ciclo
        && d.tarifarioSnapshot.planId == d.planId
        && d.tarifarioSnapshot.planNombre == d.planNombre
        && d.tarifarioSnapshot.modalidad == d.modalidad
        && d.tarifarioSnapshot.turno == d.turno
        && d.tarifarioSnapshot.tipoCobro == d.tipoCobroReferencia
        && d.tarifarioSnapshot.cobroInicial == d.cobroInicial
        && d.tarifarioSnapshot.conceptoInicial == d.conceptoPagoInicial
        && d.tarifarioSnapshot.precioAplicado == d.precioReferencia
        && d.tarifarioSnapshot.matricula == d.matriculaReferencia
        && d.tarifarioSnapshot.totalInicial == d.totalInicial
        && d.tarifarioSnapshot.totalInicialCentimos
          == d.montoPagoInicialCentimos
        && d.tarifarioSnapshot.moneda == d.moneda
        && d.tarifarioSnapshot.detallePagosPosteriores
          == d.detallePagosPosteriores;
    }

    function validPreTechnicalData(d) {
      return d.userAgent is string
        && d.userAgent.size() <= 1000
        && d.pageUrl is string
        && d.pageUrl.size() <= 1000
        && d.createdAt == request.time
        && d.updatedAt == request.time;
    }

    /*
     * PREINSCRIPCIONES
     */
    match /preinscripciones/{id} {

      allow create: if hasAllowedPreinscripcionFields(
          request.resource.data
        )
        && validPreApplicant(request.resource.data)
        && validPreProgram(request.resource.data)
        && validPreAmounts(request.resource.data)
        && validPreInitialState(request.resource.data)
        && validPreLegal(request.resource.data)
        && validPreSnapshot(request.resource.data)
        && validPreTechnicalData(request.resource.data);

      allow read, update, delete: if isAdmin();
    }

    /*
     * USUARIOS / NOSTRACUENTAS
     */
    match /users/{uid} {

      allow read: if isAdmin()
        || (
          request.auth != null
          && request.auth.uid == uid
        );

      allow create: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly([
          'uid',
          'username',
          'usernameLower',
          'authEmail',
          'institutionalEmail',
          'microsoftVerified',
          'name',
          'role',
          'roleLabel',
          'detail',
          'status',
          'blocked',
          'createdAt'
        ])

        && request.resource.data.uid == uid

        && request.resource.data.username is string
        && request.resource.data.username.size() >= 5
        && request.resource.data.username.size() <= 20

        && request.resource.data.usernameLower
          == request.resource.data.username

        && request.resource.data.authEmail is string
        && request.resource.data.authEmail.size() >= 10
        && request.resource.data.authEmail.size() <= 100

        && request.resource.data.institutionalEmail is string
        && request.resource.data.institutionalEmail.matches(
          '^[^@]+@gruponostradamus\\.edu\\.pe$'
        )

        && request.resource.data.microsoftVerified == true

        && request.resource.data.name is string
        && request.resource.data.name.size() >= 5
        && request.resource.data.name.size() <= 80

        && request.resource.data.role
          in ['student', 'teacher']

        && request.resource.data.roleLabel
          in ['Alumno', 'Docente']

        && request.resource.data.detail is string
        && request.resource.data.detail.size() >= 3
        && request.resource.data.detail.size() <= 80

        && request.resource.data.status == 'pending'
        && request.resource.data.blocked == false
        && request.resource.data.createdAt == request.time;

      allow update, delete: if isAdmin();
    }

    /*
     * NOMBRES DE USUARIO
     */
    match /usernames/{username} {

      allow read: if true;

      allow create: if request.auth != null
        && !exists(
          /databases/$(database)/documents/usernames/$(username)
        )
        && request.resource.data.keys().hasOnly([
          'uid',
          'institutionalEmail',
          'createdAt'
        ])

        && request.resource.data.uid == request.auth.uid

        && request.resource.data.institutionalEmail is string
        && request.resource.data.institutionalEmail.matches(
          '^[^@]+@gruponostradamus\\.edu\\.pe$'
        )

        && request.resource.data.createdAt == request.time;

      allow update, delete: if isAdmin();
    }

    /*
     * MENSAJES DE NOSTRACHAT
     */
    match /rooms/{roomId}/messages/{messageId} {

      allow read: if canReadRoom(roomId);

      allow create: if canCreateInRoom(roomId)
        && request.resource.data.keys().hasOnly([
          'text',
          'name',
          'extra',
          'zone',
          'roomId',
          'roomLabel',
          'sessionId',
          'type',
          'moderationStatus',
          'createdAt',

          'hasImage',
          'imageData',
          'imageMime',
          'imageWidth',
          'imageHeight',
          'imageSizeBytes',
          'imageOriginalName',
          'imageUrl',
          'imagePath',

          'damusVision',
          'sourceMessageId',
          'requestedBy',

          'pinned',
          'expiresAt'
        ])

        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 6000

        && request.resource.data.name is string
        && request.resource.data.name.size() >= 3
        && request.resource.data.name.size() <= 60

        && request.resource.data.extra is string
        && request.resource.data.extra.size() >= 3
        && request.resource.data.extra.size() <= 150

        && request.resource.data.roomId == roomId

        && request.resource.data.roomLabel is string
        && request.resource.data.roomLabel.size() >= 3
        && request.resource.data.roomLabel.size() <= 40

        && (
          (
            isAlumnoRoom(roomId)
            && request.resource.data.zone == 'alumnos'
          )
          ||
          (
            isExternoRoom(roomId)
            && request.resource.data.zone == 'externos'
          )
        )

        && request.resource.data.sessionId is string
        && request.resource.data.sessionId.size() <= 120

        && request.resource.data.type == 'message'
        && request.resource.data.moderationStatus == 'visible'

        && (
          !request.resource.data.keys().hasAny(['pinned'])
          || request.resource.data.pinned == false
        )

        && (
          !request.resource.data.keys().hasAny(['expiresAt'])
          || (
            request.resource.data.expiresAt is timestamp
            && request.resource.data.expiresAt > request.time
          )
        )

        && (
          !request.resource.data.keys().hasAny(['imageUrl'])
          || (
            request.resource.data.imageUrl is string
            && request.resource.data.imageUrl.size() <= 2000
          )
        )

        && (
          !request.resource.data.keys().hasAny(['imagePath'])
          || (
            request.resource.data.imagePath is string
            && request.resource.data.imagePath.size() <= 500
          )
        )

        && request.resource.data.createdAt == request.time;

      allow update, delete: if isAdmin();
    }

    /*
     * REPORTES
     */
    match /rooms/{roomId}/reports/{reportId} {

      allow read: if isAdmin();

      allow create: if canCreateInRoom(roomId)
        && request.resource.data.createdAt == request.time;

      allow update, delete: if isAdmin();
    }

    /*
     * PRESENCIA
     */
    match /rooms/{roomId}/presence/{sessionId} {

      allow read: if isOfficialRoom(roomId);

      allow create, update: if canCreateInRoom(roomId)
        && request.resource.data.lastSeen == request.time;

      allow delete: if isAdmin();
    }

    /*
     * PROGRAMAS, PLANES, PRECIOS, HORARIOS Y PROMOCIONES
     */
    match /programas_publicos/{programId} {

      allow read: if true;

      allow create, update: if isAdmin()
        && programId in [
          'nostra-360-uni',
          'nostra-power-uni',
          'nostra-elite-uni',
          'nostra-prime-uni',
          'nostra-talentum-uni',
          'ciclo-ien',
          'proyecto-escolar',
          'paralelo-cepre-uni',
          'ciclo-verano-uni'
        ];

      allow delete: if false;
    }

    /*
     * LIBRO DE RECLAMACIONES
     */
    match /libro_reclamaciones/{reclamoId} {

      /*
       * El formulario público puede crear una hoja.
       * No se permite lectura pública de reclamos.
       */
      allow create: if request.resource.data.keys().hasOnly([
        'codigo',
        'tipo',
        'consumidor',
        'apoderado',
        'servicio',
        'detalle',
        'pedido',
        'declaracionAceptada',
        'estado',
        'estadoAtencion',
        'respuestaAdministrativa',
        'responsable',
        'notificacionPendiente',
        'plazoMaximoDiasHabiles',
        'origen',
        'versionFormato',
        'pageUrl',
        'userAgent',
        'createdAt',
        'updatedAt'
      ])

      && request.resource.data.codigo is string
      && request.resource.data.codigo.matches(
        '^LR-[0-9]{4}-[A-Z0-9]{8}$'
      )

      && request.resource.data.tipo
        in ['reclamo', 'queja']

      && request.resource.data.consumidor is map
      && request.resource.data.consumidor.keys().hasOnly([
        'nombres',
        'tipoDocumento',
        'numeroDocumento',
        'correo',
        'celular',
        'direccion',
        'distrito',
        'ubicacion',
        'menorEdad'
      ])

      && request.resource.data.consumidor.nombres is string
      && request.resource.data.consumidor.nombres.size() >= 5
      && request.resource.data.consumidor.nombres.size() <= 120

      && request.resource.data.consumidor.tipoDocumento
        in ['DNI', 'CE', 'Pasaporte', 'Otro']

      && request.resource.data.consumidor.numeroDocumento is string
      && request.resource.data.consumidor.numeroDocumento.size() >= 6
      && request.resource.data.consumidor.numeroDocumento.size() <= 20

      && request.resource.data.consumidor.correo is string
      && request.resource.data.consumidor.correo.size() >= 5
      && request.resource.data.consumidor.correo.size() <= 120

      && request.resource.data.consumidor.celular is string
      && request.resource.data.consumidor.celular.size() >= 9
      && request.resource.data.consumidor.celular.size() <= 20

      && request.resource.data.consumidor.direccion is string
      && request.resource.data.consumidor.direccion.size() >= 5
      && request.resource.data.consumidor.direccion.size() <= 180

      && request.resource.data.consumidor.distrito is string
      && request.resource.data.consumidor.distrito.size() <= 80

      && request.resource.data.consumidor.ubicacion is string
      && request.resource.data.consumidor.ubicacion.size() <= 120

      && request.resource.data.consumidor.menorEdad is bool

      && request.resource.data.apoderado is map
      && request.resource.data.apoderado.keys().hasOnly([
        'nombres',
        'numeroDocumento',
        'correo',
        'celular'
      ])

      && request.resource.data.apoderado.nombres is string
      && request.resource.data.apoderado.nombres.size() <= 120

      && request.resource.data.apoderado.numeroDocumento is string
      && request.resource.data.apoderado.numeroDocumento.size() <= 20

      && request.resource.data.apoderado.correo is string
      && request.resource.data.apoderado.correo.size() <= 120

      && request.resource.data.apoderado.celular is string
      && request.resource.data.apoderado.celular.size() <= 20

      && (
        (
          request.resource.data.consumidor.menorEdad == true

          && request.resource.data.apoderado.nombres.size() >= 5
          && request.resource.data.apoderado.numeroDocumento.size() >= 6
          && request.resource.data.apoderado.correo.size() >= 5
          && request.resource.data.apoderado.celular.size() >= 9
        )
        ||
        (
          request.resource.data.consumidor.menorEdad == false

          && request.resource.data.apoderado.nombres == ''
          && request.resource.data.apoderado.numeroDocumento == ''
          && request.resource.data.apoderado.correo == ''
          && request.resource.data.apoderado.celular == ''
        )
      )

      && request.resource.data.servicio is map
      && request.resource.data.servicio.keys().hasOnly([
        'tipo',
        'nombre',
        'fecha',
        'monto',
        'comprobante'
      ])

      && request.resource.data.servicio.tipo
        == 'servicio educativo'

      && request.resource.data.servicio.nombre is string
      && request.resource.data.servicio.nombre.size() >= 3
      && request.resource.data.servicio.nombre.size() <= 160

      && request.resource.data.servicio.fecha is string
      && request.resource.data.servicio.fecha.size() <= 10

      && request.resource.data.servicio.monto is number
      && request.resource.data.servicio.monto >= 0
      && request.resource.data.servicio.monto <= 100000

      && request.resource.data.servicio.comprobante is string
      && request.resource.data.servicio.comprobante.size() <= 100

      && request.resource.data.detalle is string
      && request.resource.data.detalle.size() >= 20
      && request.resource.data.detalle.size() <= 4000

      && request.resource.data.pedido is string
      && request.resource.data.pedido.size() >= 10
      && request.resource.data.pedido.size() <= 2000

      && request.resource.data.declaracionAceptada == true

      && request.resource.data.estado == 'recibido'
      && request.resource.data.estadoAtencion == 'pendiente'

      && request.resource.data.respuestaAdministrativa is string
      && request.resource.data.respuestaAdministrativa == ''

      && request.resource.data.responsable is string
      && request.resource.data.responsable == ''

      && request.resource.data.notificacionPendiente == true
      && request.resource.data.plazoMaximoDiasHabiles == 15

      && request.resource.data.origen
        == 'libro_reclamaciones_web'

      && request.resource.data.versionFormato
        == '2026-01'

      && request.resource.data.pageUrl is string
      && request.resource.data.pageUrl.size() <= 1000

      && request.resource.data.userAgent is string
      && request.resource.data.userAgent.size() <= 1000

      && request.resource.data.createdAt == request.time
      && request.resource.data.updatedAt == request.time;

      /*
       * Solo el administrador puede leer y actualizar
       * los registros del Libro de Reclamaciones.
       */
      allow read, update: if isAdmin();

      /*
       * Los reclamos no se eliminan desde la web.
       */
      allow delete: if false;
    }

    /*
     * TODO LO DEMÁS QUEDA BLOQUEADO
     */
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
