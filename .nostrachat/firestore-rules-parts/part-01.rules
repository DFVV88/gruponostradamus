        'precioReferencia',
        'matriculaReferencia',
        'tipoCobroReferencia',
        'cobroInicial',
        'conceptoPagoInicial',
        'totalInicial',
        'montoPagoInicial',
        'montoPagoInicialCentimos',
        'moneda',
        'detallePagosPosteriores',

        'apoderado',
        'celularApoderado',
        'comentario',
        'confirmacion',

        'metodoPagoPreferido',
        'metodoPagoLabel',
        'estadoPago',
        'pagoValidado',
        'pagoObservacion',
        'precioValidadoServidor',
        'estadoPrecio',
        'intentoPagoCreado',
