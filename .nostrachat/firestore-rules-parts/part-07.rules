
      && request.resource.data.apoderado.celular is string
      && request.resource.data.apoderado.celular.size() <= 20

      && (
        (
          request.resource.data.consumidor.menorEdad == true

          && request.resource.data.apoderado.nombres.size() >= 5
          && request.resource.data.apoderado.numeroDocumento.size() >= 6
          && request.resource.data.apoderado.correo.size() >= 5
          && request.resource.data.apoderado.celular.size() >= 9
        )
        ||
        (
          request.resource.data.consumidor.menorEdad == false

          && request.resource.data.apoderado.nombres == ''
          && request.resource.data.apoderado.numeroDocumento == ''
          && request.resource.data.apoderado.correo == ''
          && request.resource.data.apoderado.celular == ''
        )
      )

      && request.resource.data.servicio is map
      && request.resource.data.servicio.keys().hasOnly([
        'tipo',
        'nombre',
        'fecha',
        'monto',
        'comprobante'
      ])

      && request.resource.data.servicio.tipo
        == 'servicio educativo'

      && request.resource.data.servicio.nombre is string
      && request.resource.data.servicio.nombre.size() >= 3
      && request.resource.data.servicio.nombre.size() <= 160

      && request.resource.data.servicio.fecha is string
      && request.resource.data.servicio.fecha.size() <= 10

      && request.resource.data.servicio.monto is number
      && request.resource.data.servicio.monto >= 0
      && request.resource.data.servicio.monto <= 100000

      && request.resource.data.servicio.comprobante is string
      && request.resource.data.servicio.comprobante.size() <= 100

      && request.resource.data.detalle is string
      && request.resource.data.detalle.size() >= 20
      && request.resource.data.detalle.size() <= 4000

      && request.resource.data.pedido is string
      && request.resource.data.pedido.size() >= 10
      && request.resource.data.pedido.size() <= 2000

      && request.resource.data.declaracionAceptada == true

      && request.resource.data.estado == 'recibido'
      && request.resource.data.estadoAtencion == 'pendiente'

      && request.resource.data.respuestaAdministrativa is string
      && request.resource.data.respuestaAdministrativa == ''

      && request.resource.data.responsable is string
      && request.resource.data.responsable == ''

      && request.resource.data.notificacionPendiente == true
      && request.resource.data.plazoMaximoDiasHabiles == 15

      && request.resource.data.origen
        == 'libro_reclamaciones_web'

      && request.resource.data.versionFormato
        == '2026-01'

      && request.resource.data.pageUrl is string
      && request.resource.data.pageUrl.size() <= 1000

      && request.resource.data.userAgent is string
      && request.resource.data.userAgent.size() <= 1000

      && request.resource.data.createdAt == request.time
      && request.resource.data.updatedAt == request.time;

      /*
       * Solo el administrador puede leer y actualizar
       * los registros del Libro de Reclamaciones.
       */
      allow read, update: if isAdmin();

      /*
       * Los reclamos no se eliminan desde la web.
       */
      allow delete: if false;
    }

    /*
     * COMPROBANTES DE PAGOS DE ALUMNOS
     * El archivo vive en Storage y este documento lo vincula
     * con el movimiento financiero, el alumno y la cuota.
     */
    match /comprobantes_pago/{comprobanteId} {
      allow read: if isAdmin();

      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly([
          'comprobanteId',
          'preinscripcionId',
          'movimientoFinancieroId',
          'cuotaId',
          'abonoId',
          'tipoPago',
          'storagePath',
          'downloadUrl',
          'nombreOriginal',
          'contentType',
          'sizeBytes',
          'estado',
          'origen',
          'subidoPor',
          'createdAt'
        ])
        && request.resource.data.comprobanteId == comprobanteId
        && request.resource.data.preinscripcionId is string
        && request.resource.data.preinscripcionId.size() >= 5
        && request.resource.data.preinscripcionId.size() <= 160
        && request.resource.data.movimientoFinancieroId == comprobanteId
        && request.resource.data.cuotaId is string
        && request.resource.data.cuotaId.size() <= 160
        && request.resource.data.abonoId is string
        && request.resource.data.abonoId.size() <= 160
        && request.resource.data.tipoPago in [
          'pago_inicial',
          'abono_cuota'
        ]
        && request.resource.data.storagePath is string
        && request.resource.data.storagePath.size() >= 20
        && request.resource.data.storagePath.size() <= 1000
        && request.resource.data.storagePath.matches(
          '^comprobantes-pago/.*'
        )
        && request.resource.data.downloadUrl is string
        && request.resource.data.downloadUrl.size() >= 20
        && request.resource.data.downloadUrl.size() <= 3000
        && request.resource.data.nombreOriginal is string
        && request.resource.data.nombreOriginal.size() >= 1
        && request.resource.data.nombreOriginal.size() <= 180
        && request.resource.data.contentType in [
          'image/jpeg',
          'image/png',
          'application/pdf'
        ]
        && request.resource.data.sizeBytes is int
        && request.resource.data.sizeBytes > 0
        && request.resource.data.sizeBytes <= 8388608
        && request.resource.data.estado == 'activo'
        && request.resource.data.origen == 'voucher_admin'
        && request.resource.data.subidoPor
          == request.auth.token.email
        && request.resource.data.createdAt == request.time
        && exists(
          /databases/$(database)/documents/finanzas_movimientos/$(comprobanteId)
        )
        && get(
          /databases/$(database)/documents/finanzas_movimientos/$(comprobanteId)
        ).data.preinscripcionId
          == request.resource.data.preinscripcionId
        && (
          (
            request.resource.data.tipoPago == 'pago_inicial'
            && request.resource.data.cuotaId == ''
            && request.resource.data.abonoId == ''
          )
          ||
          (
            request.resource.data.tipoPago == 'abono_cuota'
            && request.resource.data.cuotaId.size() >= 5
            && request.resource.data.abonoId.size() >= 5
            && exists(
              /databases/$(database)/documents/alumno_abonos/$(request.resource.data.abonoId)
            )
            && get(
              /databases/$(database)/documents/alumno_abonos/$(request.resource.data.abonoId)
            ).data.cuotaId == request.resource.data.cuotaId
            && get(
              /databases/$(database)/documents/alumno_abonos/$(request.resource.data.abonoId)
            ).data.movimientoFinancieroId == comprobanteId
          )
        );

      allow update, delete: if false;
    }

    /*