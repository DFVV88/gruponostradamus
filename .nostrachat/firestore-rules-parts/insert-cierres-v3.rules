    /*
     * CIERRES DIARIOS V3
     * Regla compacta y segura para evitar rechazos por validaciones
     * matemáticas duplicadas. Los cálculos se verifican en la interfaz;
     * Firestore protege identidad, estructura, tipos e inmutabilidad.
     */
    function isClosureNumberV3(value) {
      return value is int || value is float;
    }

    function validClosureAccountV3(account) {
      return account is map
        && account.keys().hasAll([
          'saldoInicialCentimos',
          'entradasCentimos',
          'salidasCentimos',
          'saldoEsperadoCentimos',
          'saldoRealCentimos',
          'diferenciaCentimos'
        ])
        && account.keys().hasOnly([
          'saldoInicialCentimos',
          'entradasCentimos',
          'salidasCentimos',
          'saldoEsperadoCentimos',
          'saldoRealCentimos',
          'diferenciaCentimos'
        ])
        && isClosureNumberV3(account.saldoInicialCentimos)
        && isClosureNumberV3(account.entradasCentimos)
        && isClosureNumberV3(account.salidasCentimos)
        && isClosureNumberV3(account.saldoEsperadoCentimos)
        && isClosureNumberV3(account.saldoRealCentimos)
        && isClosureNumberV3(account.diferenciaCentimos)
        && account.saldoInicialCentimos >= -100000000000
        && account.saldoInicialCentimos <= 100000000000
        && account.entradasCentimos >= 0
        && account.entradasCentimos <= 100000000000
        && account.salidasCentimos >= 0
        && account.salidasCentimos <= 100000000000
        && account.saldoEsperadoCentimos >= -100000000000
        && account.saldoEsperadoCentimos <= 100000000000
        && account.saldoRealCentimos >= -100000000000
        && account.saldoRealCentimos <= 100000000000
        && account.diferenciaCentimos >= -100000000000
        && account.diferenciaCentimos <= 100000000000;
    }

    function validClosureAccountsV3(accounts) {
      return accounts is map
        && accounts.keys().hasAll([
          'caja_efectivo',
          'yape',
          'plin',
          'bcp',
          'culqi',
          'otra'
        ])
        && accounts.keys().hasOnly([
          'caja_efectivo',
          'yape',
          'plin',
          'bcp',
          'culqi',
          'otra'
        ])
        && validClosureAccountV3(accounts.caja_efectivo)
        && validClosureAccountV3(accounts.yape)
        && validClosureAccountV3(accounts.plin)
        && validClosureAccountV3(accounts.bcp)
        && validClosureAccountV3(accounts.culqi)
        && validClosureAccountV3(accounts.otra);
    }

    match /finanzas_cierres/{cierreId} {
      allow create: if isAdmin()
        && request.resource.data.keys().hasAll([
          'fechaCierre',
          'estado',
          'cuentas',
          'totalIngresosDiaCentimos',
          'totalEgresosDiaCentimos',
          'operacionesDia',
          'saldoEsperadoTotalCentimos',
          'saldoRealTotalCentimos',
          'diferenciaTotalCentimos',
          'tieneDiferencia',
          'observacion',
          'cerradoPor',
          'origen',
          'version',
          'closedAt',
          'createdAt'
        ])
        && request.resource.data.keys().hasOnly([
          'fechaCierre',
          'estado',
          'cuentas',
          'totalIngresosDiaCentimos',
          'totalEgresosDiaCentimos',
          'operacionesDia',
          'saldoEsperadoTotalCentimos',
          'saldoRealTotalCentimos',
          'diferenciaTotalCentimos',
          'tieneDiferencia',
          'observacion',
          'cerradoPor',
          'origen',
          'version',
          'closedAt',
          'createdAt'
        ])
        && request.resource.data.fechaCierre is string
        && request.resource.data.fechaCierre.matches(
          '^[0-9]{4}-[0-9]{2}-[0-9]{2}$'
        )
        && request.resource.data.fechaCierre == cierreId
        && request.resource.data.estado == 'cerrado'
        && validClosureAccountsV3(request.resource.data.cuentas)
        && isClosureNumberV3(
          request.resource.data.totalIngresosDiaCentimos
        )
        && request.resource.data.totalIngresosDiaCentimos >= 0
        && request.resource.data.totalIngresosDiaCentimos
          <= 100000000000
        && isClosureNumberV3(
          request.resource.data.totalEgresosDiaCentimos
        )
        && request.resource.data.totalEgresosDiaCentimos >= 0
        && request.resource.data.totalEgresosDiaCentimos
          <= 100000000000
        && isClosureNumberV3(request.resource.data.operacionesDia)
        && request.resource.data.operacionesDia >= 0
        && request.resource.data.operacionesDia <= 100000
        && isClosureNumberV3(
          request.resource.data.saldoEsperadoTotalCentimos
        )
        && isClosureNumberV3(
          request.resource.data.saldoRealTotalCentimos
        )
        && isClosureNumberV3(
          request.resource.data.diferenciaTotalCentimos
        )
        && request.resource.data.tieneDiferencia is bool
        && request.resource.data.observacion is string
        && request.resource.data.observacion.size() <= 1000
        && request.resource.data.cerradoPor
          == request.auth.token.email
        && request.resource.data.origen == 'cierre_diario_admin'
        && request.resource.data.version in [
          '2026-08',
          '2026-08-v2',
          '2026-08-v3'
        ]
        && request.resource.data.closedAt == request.time
        && request.resource.data.createdAt == request.time;

      allow update, delete: if false;
    }
