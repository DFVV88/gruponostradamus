     * FINANZAS ADMINISTRATIVAS
     */
    function validFinanceClosureAccount(a) {
      return a is map
        && a.keys().hasAll([
          'saldoInicialCentimos',
          'entradasCentimos',
          'salidasCentimos',
          'saldoEsperadoCentimos',
          'saldoRealCentimos',
          'diferenciaCentimos'
        ])
        && a.keys().hasOnly([
          'saldoInicialCentimos',
          'entradasCentimos',
          'salidasCentimos',
          'saldoEsperadoCentimos',
          'saldoRealCentimos',
          'diferenciaCentimos'
        ])
        && a.saldoInicialCentimos is int
        && a.saldoInicialCentimos >= -100000000000
        && a.saldoInicialCentimos <= 100000000000
        && a.entradasCentimos is int
        && a.entradasCentimos >= 0
        && a.entradasCentimos <= 100000000000
        && a.salidasCentimos is int
        && a.salidasCentimos >= 0
        && a.salidasCentimos <= 100000000000
        && a.saldoEsperadoCentimos is int
        && a.saldoEsperadoCentimos >= -100000000000
        && a.saldoEsperadoCentimos <= 100000000000
        && a.saldoRealCentimos is int
        && a.saldoRealCentimos >= -100000000000
        && a.saldoRealCentimos <= 100000000000
        && a.diferenciaCentimos is int
        && a.diferenciaCentimos >= -100000000000
        && a.diferenciaCentimos <= 100000000000
        && a.saldoEsperadoCentimos
          == a.saldoInicialCentimos
            + a.entradasCentimos
            - a.salidasCentimos
        && a.diferenciaCentimos
          == a.saldoRealCentimos
            - a.saldoEsperadoCentimos;
    }

    function validFinanceClosureAccounts(c) {
      return c is map
        && c.keys().hasAll([
          'caja_efectivo',
          'yape',
          'plin',
          'bcp',
          'culqi',
          'otra'
        ])
        && c.keys().hasOnly([
          'caja_efectivo',
          'yape',
          'plin',
          'bcp',
          'culqi',
          'otra'
        ])
        && validFinanceClosureAccount(c.caja_efectivo)
        && validFinanceClosureAccount(c.yape)
        && validFinanceClosureAccount(c.plin)
        && validFinanceClosureAccount(c.bcp)
        && validFinanceClosureAccount(c.culqi)
        && validFinanceClosureAccount(c.otra);
    }

    match /finanzas_movimientos/{movimientoId} {

      allow read: if isAdmin();

      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly([
          'tipo',
          'fechaOperacion',
          'categoria',
          'concepto',
          'monto',
          'metodoPago',
          'cuenta',
          'numeroOperacion',
          'observacion',
          'estado',
          'origen',
          'creadoPor',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.tipo in ['ingreso', 'egreso']
        && request.resource.data.fechaOperacion is string
        && request.resource.data.fechaOperacion.size() == 10
        && request.resource.data.categoria is string
        && request.resource.data.categoria.size() >= 3
        && request.resource.data.categoria.size() <= 60
        && request.resource.data.concepto is string
        && request.resource.data.concepto.size() >= 3
        && request.resource.data.concepto.size() <= 160
        && request.resource.data.monto is number
        && request.resource.data.monto > 0
        && request.resource.data.monto <= 1000000
        && request.resource.data.metodoPago in [
          'efectivo',
          'yape',
          'plin',
          'transferencia',
          'culqi',
          'otro'
        ]
        && request.resource.data.cuenta in [
          'caja_efectivo',
          'yape',
          'plin',
          'bcp',
          'culqi',
          'otra'
        ]
        && request.resource.data.numeroOperacion is string
        && request.resource.data.numeroOperacion.size() <= 100
        && request.resource.data.observacion is string
        && request.resource.data.observacion.size() <= 1000
        && request.resource.data.estado == 'activo'
        && request.resource.data.origen == 'manual_admin'
        && request.resource.data.creadoPor
          == request.auth.token.email
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      /*
       * Única modificación permitida: pasar de activo a anulado.
       * El movimiento original permanece y debe generarse simultáneamente
       * su documento de auditoría con el mismo identificador.
       */
      allow update: if isAdmin()
        && resource.data.estado == 'activo'
        && request.resource.data.estado == 'anulado'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'estado',
          'motivoAnulacion',
          'anuladoPor',
          'anuladoEn',
          'updatedAt'
        ])
        && request.resource.data.motivoAnulacion is string
        && request.resource.data.motivoAnulacion.size() >= 5
        && request.resource.data.motivoAnulacion.size() <= 500
        && request.resource.data.anuladoPor
          == request.auth.token.email
        && request.resource.data.anuladoEn == request.time
        && request.resource.data.updatedAt == request.time
        && getAfter(
          /databases/$(database)/documents/finanzas_auditoria/$(movimientoId)
        ).data.movimientoId == movimientoId
        && getAfter(
          /databases/$(database)/documents/finanzas_auditoria/$(movimientoId)
        ).data.accion == 'anulacion';

      allow delete: if false;
    }

    /*
     * AUDITORÍA FINANCIERA
     * Un documento por movimiento anulado. No puede editarse ni borrarse.
     */
    match /finanzas_auditoria/{auditoriaId} {

      allow read: if isAdmin();

      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly([
          'movimientoId',
          'accion',
          'motivo',
          'estadoAnterior',
          'estadoNuevo',
          'ejecutadoPor',
          'fechaOperacion',
          'tipo',
          'categoria',
          'concepto',
          'monto',
          'cuenta',
          'numeroOperacion',
          'origen',
          'createdAt'
        ])
        && request.resource.data.movimientoId == auditoriaId
        && request.resource.data.accion == 'anulacion'
        && request.resource.data.motivo is string
        && request.resource.data.motivo.size() >= 5
        && request.resource.data.motivo.size() <= 500
        && request.resource.data.estadoAnterior == 'activo'
        && request.resource.data.estadoNuevo == 'anulado'
        && request.resource.data.ejecutadoPor
          == request.auth.token.email
        && request.resource.data.fechaOperacion is string
        && request.resource.data.fechaOperacion.size() == 10
        && request.resource.data.tipo in ['ingreso', 'egreso']
        && request.resource.data.categoria is string
        && request.resource.data.categoria.size() >= 3
        && request.resource.data.categoria.size() <= 60
        && request.resource.data.concepto is string
        && request.resource.data.concepto.size() >= 3
        && request.resource.data.concepto.size() <= 160
        && request.resource.data.monto is number
        && request.resource.data.monto > 0
        && request.resource.data.monto <= 1000000
        && request.resource.data.cuenta in [
          'caja_efectivo',
          'yape',
          'plin',
          'bcp',
          'culqi',
          'otra'
        ]
        && request.resource.data.numeroOperacion is string
        && request.resource.data.numeroOperacion.size() <= 100
        && request.resource.data.origen == 'manual_admin'
        && request.resource.data.createdAt == request.time
        && get(
          /databases/$(database)/documents/finanzas_movimientos/$(auditoriaId)
        ).data.estado == 'activo'
        && getAfter(
          /databases/$(database)/documents/finanzas_movimientos/$(auditoriaId)
        ).data.estado == 'anulado'
        && request.resource.data.fechaOperacion == get(
          /databases/$(database)/documents/finanzas_movimientos/$(auditoriaId)
        ).data.fechaOperacion
        && request.resource.data.tipo == get(
          /databases/$(database)/documents/finanzas_movimientos/$(auditoriaId)
        ).data.tipo
        && request.resource.data.categoria == get(
          /databases/$(database)/documents/finanzas_movimientos/$(auditoriaId)
        ).data.categoria
        && request.resource.data.concepto == get(
          /databases/$(database)/documents/finanzas_movimientos/$(auditoriaId)
        ).data.concepto
        && request.resource.data.monto == get(
          /databases/$(database)/documents/finanzas_movimientos/$(auditoriaId)
        ).data.monto
        && request.resource.data.cuenta == get(
          /databases/$(database)/documents/finanzas_movimientos/$(auditoriaId)
        ).data.cuenta
        && request.resource.data.numeroOperacion == get(
          /databases/$(database)/documents/finanzas_movimientos/$(auditoriaId)
        ).data.numeroOperacion
        && request.resource.data.origen == get(
          /databases/$(database)/documents/finanzas_movimientos/$(auditoriaId)
        ).data.origen;

      allow update, delete: if false;
    }

    /*
     * CIERRES DIARIOS Y CONCILIACIÓN
     * Un cierre inmutable por fecha, identificado por YYYY-MM-DD.
     */
    match /finanzas_cierres/{cierreId} {

      allow read: if isAdmin();

      allow create: if isAdmin()
        && !exists(
          /databases/$(database)/documents/finanzas_cierres/$(cierreId)
        )
        && request.resource.data.keys().hasAll([
          'fechaCierre',
          'estado',
          'cuentas',
          'totalIngresosDiaCentimos',
          'totalEgresosDiaCentimos',
          'operacionesDia',
          'saldoEsperadoTotalCentimos',
          'saldoRealTotalCentimos',
          'diferenciaTotalCentimos',
          'tieneDiferencia',
          'observacion',
          'cerradoPor',
          'origen',
          'version',
          'closedAt',
          'createdAt'
        ])
        && request.resource.data.keys().hasOnly([
          'fechaCierre',
          'estado',
          'cuentas',
          'totalIngresosDiaCentimos',
          'totalEgresosDiaCentimos',
          'operacionesDia',
          'saldoEsperadoTotalCentimos',
          'saldoRealTotalCentimos',
          'diferenciaTotalCentimos',
          'tieneDiferencia',
          'observacion',
          'cerradoPor',
          'origen',
          'version',
          'closedAt',
          'createdAt'
        ])
        && request.resource.data.fechaCierre is string
        && request.resource.data.fechaCierre.size() == 10
        && request.resource.data.fechaCierre.matches(
          '^[0-9]{4}-[0-9]{2}-[0-9]{2}$'
        )
        && request.resource.data.fechaCierre == cierreId
        && request.resource.data.estado == 'cerrado'
        && validFinanceClosureAccounts(
          request.resource.data.cuentas
        )
        && request.resource.data.totalIngresosDiaCentimos is int
        && request.resource.data.totalIngresosDiaCentimos >= 0
        && request.resource.data.totalIngresosDiaCentimos
          <= 100000000000
        && request.resource.data.totalEgresosDiaCentimos is int
        && request.resource.data.totalEgresosDiaCentimos >= 0
        && request.resource.data.totalEgresosDiaCentimos
          <= 100000000000
        && request.resource.data.operacionesDia is int
        && request.resource.data.operacionesDia >= 0
        && request.resource.data.operacionesDia <= 100000
        && request.resource.data.saldoEsperadoTotalCentimos is int
        && request.resource.data.saldoRealTotalCentimos is int
        && request.resource.data.diferenciaTotalCentimos is int
        && request.resource.data.saldoEsperadoTotalCentimos
          == request.resource.data.cuentas.caja_efectivo.saldoEsperadoCentimos
            + request.resource.data.cuentas.yape.saldoEsperadoCentimos
            + request.resource.data.cuentas.plin.saldoEsperadoCentimos
            + request.resource.data.cuentas.bcp.saldoEsperadoCentimos
            + request.resource.data.cuentas.culqi.saldoEsperadoCentimos
            + request.resource.data.cuentas.otra.saldoEsperadoCentimos
        && request.resource.data.saldoRealTotalCentimos
          == request.resource.data.cuentas.caja_efectivo.saldoRealCentimos
            + request.resource.data.cuentas.yape.saldoRealCentimos
            + request.resource.data.cuentas.plin.saldoRealCentimos
            + request.resource.data.cuentas.bcp.saldoRealCentimos
            + request.resource.data.cuentas.culqi.saldoRealCentimos
            + request.resource.data.cuentas.otra.saldoRealCentimos
        && request.resource.data.diferenciaTotalCentimos
          == request.resource.data.saldoRealTotalCentimos
            - request.resource.data.saldoEsperadoTotalCentimos
        && request.resource.data.tieneDiferencia is bool
        && request.resource.data.tieneDiferencia
          == (request.resource.data.diferenciaTotalCentimos != 0)
        && request.resource.data.observacion is string
        && request.resource.data.observacion.size() <= 1000
        && (
          request.resource.data.diferenciaTotalCentimos == 0
          || request.resource.data.observacion.size() >= 5
        )
        && request.resource.data.cerradoPor
          == request.auth.token.email
        && request.resource.data.origen == 'cierre_diario_admin'
        && request.resource.data.version == '2026-08'
        && request.resource.data.closedAt == request.time
        && request.resource.data.createdAt == request.time;

      allow update, delete: if false;
    }

    /*
     * PAGOS DE ALUMNOS INTEGRADOS CON FINANZAS
     */
    match /finanzas_movimientos/{movimientoId} {
      allow create: if isAdmin()
        && request.resource.data.keys().hasAll([
          'tipo',
          'fechaOperacion',
          'categoria',
          'concepto',
          'monto',
          'metodoPago',
          'cuenta',
          'numeroOperacion',
          'observacion',
          'estado',
          'origen',
          'creadoPor',
          'pagoId',
          'preinscripcionId',
          'registroAlumnoId',
          'matriculaId',
          'grupoId',
          'alumnoNombre',
          'alumnoDni',
          'conceptoPago',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'tipo',
          'fechaOperacion',
          'categoria',
          'concepto',
          'monto',
          'metodoPago',
          'cuenta',
          'numeroOperacion',
          'observacion',
          'estado',
          'origen',
          'creadoPor',
          'pagoId',
          'preinscripcionId',
          'registroAlumnoId',
          'matriculaId',
          'grupoId',
          'alumnoNombre',
          'alumnoDni',
          'conceptoPago',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.tipo == 'ingreso'
        && request.resource.data.fechaOperacion is string
        && request.resource.data.fechaOperacion.size() == 10
        && request.resource.data.categoria
          in ['matricula', 'pension', 'otros_ingresos']
        && request.resource.data.concepto is string
        && request.resource.data.concepto.size() >= 3
        && request.resource.data.concepto.size() <= 160
        && request.resource.data.monto is number
        && request.resource.data.monto > 0
        && request.resource.data.monto <= 1000000
        && request.resource.data.metodoPago in [
          'efectivo',
          'yape',
          'plin',
          'transferencia',
          'culqi',
          'otro'
        ]
        && request.resource.data.cuenta in [
          'caja_efectivo',
          'yape',
          'plin',
          'bcp',
          'culqi',
          'otra'
        ]
        && request.resource.data.numeroOperacion is string
        && request.resource.data.numeroOperacion.size() >= 3
        && request.resource.data.numeroOperacion.size() <= 100
        && request.resource.data.observacion is string
        && request.resource.data.observacion.size() <= 1000
        && request.resource.data.estado == 'activo'
        && request.resource.data.origen == 'pago_alumno_admin'
        && request.resource.data.creadoPor
          == request.auth.token.email
        && request.resource.data.pagoId == movimientoId
        && request.resource.data.preinscripcionId is string
        && request.resource.data.preinscripcionId.size() >= 5
        && request.resource.data.preinscripcionId.size() <= 160
        && request.resource.data.registroAlumnoId
          == request.resource.data.preinscripcionId
        && request.resource.data.matriculaId
          == request.resource.data.preinscripcionId
        && request.resource.data.grupoId is string
        && request.resource.data.grupoId.size() >= 3
        && request.resource.data.grupoId.size() <= 200
        && request.resource.data.alumnoNombre is string
        && request.resource.data.alumnoNombre.size() >= 5
        && request.resource.data.alumnoNombre.size() <= 160
        && request.resource.data.alumnoDni is string
        && request.resource.data.alumnoDni.size() >= 6
        && request.resource.data.alumnoDni.size() <= 20
        && request.resource.data.conceptoPago is string
        && request.resource.data.conceptoPago.size() >= 3
        && request.resource.data.conceptoPago.size() <= 150
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && getAfter(
          /databases/$(database)/documents/preinscripciones/$(request.resource.data.preinscripcionId)
        ).data.pagoValidado == true
        && getAfter(
          /databases/$(database)/documents/preinscripciones/$(request.resource.data.preinscripcionId)
        ).data.estadoPago == 'pago_validado'
        && getAfter(
          /databases/$(database)/documents/preinscripciones/$(request.resource.data.preinscripcionId)
        ).data.ingresoFinancieroId == movimientoId
        && getAfter(
          /databases/$(database)/documents/preinscripciones/$(request.resource.data.preinscripcionId)
        ).data.registroAlumnoId
          == request.resource.data.registroAlumnoId
        && getAfter(
          /databases/$(database)/documents/preinscripciones/$(request.resource.data.preinscripcionId)
        ).data.grupoId == request.resource.data.grupoId;
    }

    /*
     * Auditoría de movimientos creados desde pagos de alumnos.
     */
    match /finanzas_auditoria/{auditoriaId} {
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly([
          'movimientoId',
          'accion',
          'motivo',
          'estadoAnterior',
          'estadoNuevo',
          'ejecutadoPor',
          'fechaOperacion',
          'tipo',
          'categoria',
          'concepto',
          'monto',
          'cuenta',
          'numeroOperacion',
          'origen',
          'createdAt'
        ])
        && request.resource.data.movimientoId == auditoriaId
        && request.resource.data.accion == 'anulacion'
        && request.resource.data.motivo is string
        && request.resource.data.motivo.size() >= 5
        && request.resource.data.motivo.size() <= 500
        && request.resource.data.estadoAnterior == 'activo'
        && request.resource.data.estadoNuevo == 'anulado'
        && request.resource.data.ejecutadoPor
          == request.auth.token.email
        && request.resource.data.fechaOperacion is string
        && request.resource.data.fechaOperacion.size() == 10
        && request.resource.data.tipo == 'ingreso'
        && request.resource.data.categoria is string
        && request.resource.data.concepto is string
        && request.resource.data.monto is number
        && request.resource.data.monto > 0
        && request.resource.data.cuenta in [
          'caja_efectivo',
          'yape',
          'plin',
          'bcp',
          'culqi',
          'otra'
        ]
        && request.resource.data.numeroOperacion is string
        && request.resource.data.origen == 'pago_alumno_admin'
        && request.resource.data.createdAt == request.time
        && get(
          /databases/$(database)/documents/finanzas_movimientos/$(auditoriaId)
        ).data.estado == 'activo'
        && get(
          /databases/$(database)/documents/finanzas_movimientos/$(auditoriaId)
        ).data.origen == 'pago_alumno_admin'
        && getAfter(
          /databases/$(database)/documents/finanzas_movimientos/$(auditoriaId)
        ).data.estado == 'anulado'
        && request.resource.data.fechaOperacion == get(
          /databases/$(database)/documents/finanzas_movimientos/$(auditoriaId)
        ).data.fechaOperacion
        && request.resource.data.tipo == get(
          /databases/$(database)/documents/finanzas_movimientos/$(auditoriaId)
        ).data.tipo
        && request.resource.data.categoria == get(
          /databases/$(database)/documents/finanzas_movimientos/$(auditoriaId)
        ).data.categoria
        && request.resource.data.concepto == get(
          /databases/$(database)/documents/finanzas_movimientos/$(auditoriaId)
        ).data.concepto
        && request.resource.data.monto == get(
          /databases/$(database)/documents/finanzas_movimientos/$(auditoriaId)
        ).data.monto
        && request.resource.data.cuenta == get(
          /databases/$(database)/documents/finanzas_movimientos/$(auditoriaId)
        ).data.cuenta
        && request.resource.data.numeroOperacion == get(
          /databases/$(database)/documents/finanzas_movimientos/$(auditoriaId)
        ).data.numeroOperacion;
    }

    /*
     * GRUPOS, REGISTROS DE ALUMNOS Y MATRÍCULAS
     */
    match /grupos_academicos/{grupoId} {
      allow read: if isAdmin();
      allow create, update: if isAdmin()
        && request.resource.data.grupoId == grupoId;
      allow delete: if false;
    }

    match /registros_alumnos/{registroId} {
      allow read: if isAdmin();
      allow create, update: if isAdmin()
        && request.resource.data.registroAlumnoId == registroId
        && request.resource.data.preinscripcionId == registroId;
      allow delete: if false;
    }

    match /matriculas/{matriculaId} {
      allow read: if isAdmin();
      allow create, update: if isAdmin()
        && request.resource.data.matriculaId == matriculaId
        && request.resource.data.preinscripcionId == matriculaId
        && request.resource.data.registroAlumnoId == matriculaId;
      allow delete: if false;
    }

    /*
     * TODO LO DEMÁS QUEDA BLOQUEADO
     */
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
